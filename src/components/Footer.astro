---
import { getPengaturan } from '../lib/db/pengaturan';
import { getEnv } from '@lib/env';

const env = getEnv();
const s = env ? await getPengaturan(env.DB) : {};

const logo = s.situs_logo;
const logoUrl = logo ? (logo.startsWith('/') ? logo : `/api/media/${encodeURIComponent(logo)}`) : null;

const sosial = [
  { key: 'sosial_whatsapp', label: 'WhatsApp resmi kelurahan',
    icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>' },
  { key: 'sosial_facebook', label: 'Facebook resmi kelurahan',
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
  { key: 'sosial_instagram', label: 'Instagram resmi kelurahan',
    icon: '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>' },
].filter(x => s[x.key]);

const navLinks = [
  { href: '/profil', label: 'Profil Kelurahan' },
  { href: '/layanan', label: 'Layanan' },
  { href: '/wisata', label: 'Wisata' },
  { href: '/umkm', label: 'Direktori UMKM' },
  { href: '/peta', label: 'Peta Kelurahan' },
  { href: '/berita', label: 'Berita' },
];
---

<footer style="background-color: var(--color-primary-dark);" class="text-white/90">
  <div class="mx-auto max-w-6xl px-4 md:px-6 pt-12 pb-10">

    <!-- Top: identity + social -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5 mb-10">
      <div class="flex items-center gap-3">
        <span
          class="w-10 h-10 rounded-full bg-white grid place-items-center font-heading font-bold text-sm overflow-hidden"
          style="color: var(--color-primary);"
          aria-hidden="true"
        >
          {logoUrl ? (
            <img src={logoUrl} alt="Logo" class="w-full h-full object-cover" />
          ) : (
            'KP'
          )}
        </span>
        <div>
          <span class="block font-heading font-bold text-white">Kelurahan Palabuhanratu</span>
          <span class="block text-xs text-white/50">Kecamatan Palabuhanratu, Kab. Sukabumi</span>
        </div>
      </div>

      {sosial.length > 0 && (
        <div class="flex items-center gap-2">
          {sosial.map(item => (
            <a
              href={s[item.key]}
              target="_blank" rel="noopener noreferrer"
              aria-label={item.label}
              class="footer-social"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Divider -->
    <div class="h-px bg-white/10 mb-10"></div>

    <!-- Main grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-16">

      <!-- About -->
      <div>
        <h3 class="footer-heading">Tentang Kami</h3>
        <p class="text-sm text-white/60 leading-relaxed">
          Situs resmi Pemerintah Kelurahan Palabuhanratu, Kecamatan Palabuhanratu, Kabupaten Sukabumi.
          Melayani masyarakat dengan transparansi dan inovasi digital.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="footer-heading">Jelajahi</h3>
        <ul class="space-y-2">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="footer-link text-sm text-white/65 hover:text-white transition-colors duration-150">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="footer-heading">Kontak</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-white/40" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="text-sm text-white/65">{s.kontak_alamat}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-white/40" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.14 9.81 19.79 19.79 0 0 1 1.08 1.18 2 2 0 0 1 3.07 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span class="text-sm text-white/65">{s.kontak_telepon}</span>
          </li>
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-white/40" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span class="text-sm text-white/65">{s.kontak_email}</span>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/8">
    <div class="mx-auto max-w-6xl px-4 md:px-6 py-4 text-xs text-white/40 flex flex-col sm:flex-row justify-between gap-2">
      <span>© 2026 Pemerintahan Kelurahan Palabuhanratu. Seluruh aset terdaftar atas nama kelurahan.</span>
      <span>Dibuat oleh Tim KKNT Inovasi IPB 2026</span>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-family: var(--font-heading, 'Lexend', sans-serif);
    font-weight: 600;
    font-size: 0.875rem;
    color: white;
    margin-bottom: 1rem;
  }

  .footer-social {
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.08);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .footer-social:hover {
    background: rgba(255,255,255,0.15);
    color: white;
  }
</style>
