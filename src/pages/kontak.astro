---
import Layout from '../components/Layout.astro';
import { getPengaturan } from '../lib/db/pengaturan';
import { getEnv } from '@lib/env';

const env = getEnv();
import { getAllTitikPeta } from '../lib/db/titik-peta';
const s = env ? await getPengaturan(env.DB) : {};
const titikList = env ? await getAllTitikPeta(env.DB) : [];
const titikPemerintahan = titikList.find(t => t.jenis === 'pemerintahan') || { lat: -6.9873, lng: 106.5575, label: "Kantor Kelurahan Palabuhanratu" };

const kanal = [
  { key: 'sosial_whatsapp', label: 'WhatsApp resmi kelurahan', icon: 'message-circle', text: 'WhatsApp',
    cls: 'bg-cta hover:bg-ctaDark text-white' },
  { key: 'sosial_facebook', label: 'Facebook resmi kelurahan', icon: 'facebook', text: 'Facebook',
    cls: 'border-2 border-primary text-primary hover:bg-primary hover:text-white' },
  { key: 'sosial_instagram', label: 'Instagram resmi kelurahan', icon: 'instagram', text: 'Instagram',
    cls: 'border-2 border-primary text-primary hover:bg-primary hover:text-white' },
].filter(x => s[x.key]);
---

<Layout
  title="Kontak & Info | Kelurahan Palabuhanratu"
  description="Alamat, telepon, email, dan kanal resmi Pemerintah Kelurahan Palabuhanratu, Kecamatan Simpenan, Kabupaten Sukabumi."
>

<main id="main" class="mx-auto max-w-[1152px] px-4 sm:px-6 py-10">
  <h1 class="text-3xl sm:text-4xl font-heading font-extrabold text-primary">Kontak & Info Kelurahan</h1>
  <p class="text-muted mt-2 max-w-xl">Hubungi Pemerintah Kelurahan Palabuhanratu melalui kanal resmi berikut.</p>

  <div class="grid lg:grid-cols-2 gap-6 mt-8">
    <!-- Info cards -->
    <div class="space-y-4">
      {[
        { icon: 'map-pin', title: 'Alamat Kantor', content: s.kontak_alamat },
        { icon: 'phone', title: 'Telepon', content: s.kontak_telepon },
        { icon: 'mail', title: 'Email', content: s.kontak_email },
        { icon: 'clock', title: 'Jam Layanan', content: s.kontak_jam },
      ].map(item => (
        <div class="bg-white border border-line rounded-xl p-5 flex gap-4 shadow-[0_4px_10px_rgba(15,36,51,.08)]">
          <span class="w-11 h-11 rounded-full bg-sand grid place-items-center text-primary shrink-0">
            <i data-lucide={item.icon} class="w-5 h-5"></i>
          </span>
          <div>
            <h2 class="font-heading font-semibold text-ink">{item.title}</h2>
            <p class="text-muted mt-0.5">{item.content}</p>
          </div>
        </div>
      ))}

      <!-- Kanal resmi -->
      {kanal.length > 0 && (
        <div class="bg-white border border-line rounded-xl p-5 shadow-[0_4px_10px_rgba(15,36,51,.08)]">
          <h2 class="font-heading font-semibold text-ink">Kanal Resmi</h2>
          <div class="flex flex-wrap gap-3 mt-3">
            {kanal.map(item => (
              <a href={s[item.key]} target="_blank" rel="noopener noreferrer" aria-label={item.label}
                 class:list={['inline-flex items-center gap-2 font-heading font-semibold px-4 py-2.5 rounded-lg transition-colors min-h-[44px]', item.cls]}>
                <i data-lucide={item.icon} class="w-5 h-5"></i> {item.text}
              </a>
            ))}
          </div>
          <p class="text-xs text-muted mt-3">Tidak ada formulir kontak di situs ini, silakan hubungi kami langsung lewat kanal di atas.</p>
        </div>
      )}
    </div>

    <!-- Map -->
    <div class="relative z-0 w-full rounded-2xl overflow-hidden shadow-[0_4px_10px_rgba(15,36,51,.08)] border border-line min-h-[20rem]">
      <div id="kontak-map" class="w-full h-full absolute inset-0 z-0"></div>
      <a href="/peta"
         class="absolute bottom-4 right-4 inline-flex items-center gap-2 bg-white text-primary font-heading font-semibold px-4 py-2 rounded-lg shadow-[0_4px_10px_rgba(15,36,51,.12)] z-10 hover:bg-sand transition-colors">
        <i data-lucide="map" class="w-5 h-5"></i> Buka Peta Kelurahan
      </a>
    </div>
  </div>
</main>

</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script is:inline define:vars={{ ptLat: titikPemerintahan.lat, ptLng: titikPemerintahan.lng, ptLabel: titikPemerintahan.label }}>
  document.addEventListener('DOMContentLoaded', function() {
    var map = L.map('kontak-map', { scrollWheelZoom: false }).setView([ptLat, ptLng], 14);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
    L.marker([ptLat, ptLng]).addTo(map).bindPopup('<b>' + ptLabel + '</b><br>Kec. Palabuhanratu, Sukabumi');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  });
  setTimeout(() => { if (typeof lucide !== 'undefined') lucide.createIcons(); }, 300);
</script>
