---
import AdminLayout from '../../../components/AdminLayout.astro';
import AdminEditorToolbar from '../../../components/AdminEditorToolbar.astro';
import AdminFotoManager from '../../../components/AdminFotoManager.astro';
import { getUmkmById } from '../../../lib/db/umkm';
import { getProdukByUmkmId, formatRupiah } from '../../../lib/db/produk';
import { getMediaForEntity } from '../../../lib/db/media';

const { id } = Astro.params as { id: string };
import { getEnv } from '@lib/env';
const env = getEnv();
const umkm = env ? await getUmkmById(Number(id), env.DB) : null;
if (!umkm) return Astro.redirect('/admin/umkm');

const [mediaList, products] = await Promise.all([
  env ? getMediaForEntity('umkm', umkm.id, env.DB) : [],
  env ? getProdukByUmkmId(umkm.id, env.DB) : [],
]);

const productsWithMedia = env
  ? await Promise.all(
      products.map(async (p) => ({
        ...p,
        mediaList: await getMediaForEntity('produk', p.id, env.DB),
      }))
    )
  : [];

const saved = Astro.url.searchParams.get('saved');
const produkSaved = Astro.url.searchParams.get('produk_saved');
const produkDeleted = Astro.url.searchParams.get('produk_deleted');
const categories = ['Kuliner', 'Kriya', 'Jasa', 'Hasil Tani'];
---

<AdminLayout title={`Edit: ${umkm.nama}`} breadcrumb={`UMKM / ${umkm.nama}`}>

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Informasi UMKM berhasil disimpan.
    </div>
  )}

  {produkSaved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Produk berhasil ditambahkan ke katalog toko ini.
    </div>
  )}

  {produkDeleted && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FCA5A5;">
      Produk berhasil dihapus.
    </div>
  )}

  <div class="max-w-3xl space-y-10">

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         BAGIAN 1 — INFORMASI UMKM
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <section class="bg-white rounded-xl border border-border p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-6 pb-4 border-b border-border">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-sm font-bold shrink-0" style="background:var(--color-primary);">1</span>
        <div>
          <h2 class="font-heading font-bold text-lg" style="color:var(--color-primary);">Informasi Toko UMKM</h2>
          <p class="text-xs text-text-muted">Nama, kategori, deskripsi, dan kontak.</p>
        </div>
      </div>

      <form method="POST" action={`/api/admin/umkm/${umkm.id}`} class="space-y-5">

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="nama" class="block font-heading font-medium text-sm mb-1.5">
              Nama UMKM <span>*</span> <span class="font-normal text-text-muted">(wajib)</span>
            </label>
            <input type="text" id="nama" name="nama" required value={umkm.nama}
              class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
              style="border-color:var(--color-border); min-height:44px;" />
          </div>
          <div>
            <label for="kategori" class="block font-heading font-medium text-sm mb-1.5">
              Kategori <span>*</span> <span class="font-normal text-text-muted">(wajib)</span>
            </label>
            <select id="kategori" name="kategori" required
              class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
              style="border-color:var(--color-border); min-height:44px;">
              {categories.map(c => <option value={c} selected={umkm.kategori === c}>{c}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="lokasi" class="block font-heading font-medium text-sm mb-1.5">Lokasi</label>
          <input type="text" id="lokasi" name="lokasi" value={umkm.lokasi ?? ''}
            class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
            style="border-color:var(--color-border); min-height:44px;" />
        </div>

        <div>
          <label class="block font-heading font-medium text-sm mb-1.5">Deskripsi Toko</label>
          <AdminEditorToolbar />
          <div id="editor" contenteditable="true"
            class="w-full min-h-32 border border-t-0 rounded-b-lg px-4 py-3 text-base focus:outline-none"
            style="border-color:var(--color-border);"
            set:html={umkm.deskripsi_html}></div>
          <input type="hidden" id="deskripsi_html" name="deskripsi_html" value={umkm.deskripsi_html} />
        </div>

        <fieldset class="border border-border rounded-xl p-4">
          <legend class="font-heading font-semibold text-sm px-2" style="color:var(--color-primary);">Identitas Digital & Kontak</legend>
          <p class="text-xs text-text-muted mb-4">Isi hanya jika aktif. Kolom kosong tidak akan ditampilkan di situs.</p>
          <div class="space-y-4">
            {([
              ['wa_number',       'Nomor WhatsApp',  'tel', umkm.wa_number],
              ['telepon',         'Telepon',          'tel', umkm.telepon],
              ['google_maps_url', 'URL Google Maps',  'url', umkm.google_maps_url],
              ['toko_online_url', 'URL Toko Online',  'url', umkm.toko_online_url],
            ] as [string,string,string,string|null][]).map(([name, label, type, val]) => (
              <div>
                <label for={name} class="block font-heading font-medium text-sm mb-1">{label}</label>
                <input type={type} id={name} name={name} value={val ?? ''}
                  class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
                  style="border-color:var(--color-border); min-height:44px;" />
              </div>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="status" class="block font-heading font-medium text-sm mb-1.5">Status Profil Toko</label>
          <select id="status" name="status"
            class="rounded-lg border px-4 py-3 text-base focus:outline-none"
            style="border-color:var(--color-border); min-height:44px; min-width:160px;">
            <option value="draft" selected={umkm.status === 'draft'}>Draf</option>
            <option value="published" selected={umkm.status === 'published'}>Terbitkan</option>
          </select>
        </div>

        <div class="flex justify-end gap-3 pt-3">
          <a href="/admin/umkm"
            class="px-4 py-2 rounded-lg font-heading font-medium text-sm border hover:bg-sand"
            style="border-color:var(--color-border); min-height:44px; display:flex; align-items:center;">
            Batal
          </a>
          <button type="submit"
            class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer"
            style="background:var(--color-cta); min-height:44px;">
            Simpan Informasi Toko
          </button>
        </div>
      </form>
    </section>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         BAGIAN 2 — FOTO UMKM (bukan foto produk)
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <section class="bg-white rounded-xl border border-border shadow-sm overflow-hidden">
      <div class="flex items-center gap-3 px-6 py-4 border-b border-border" style="background:var(--color-sand);">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-sm font-bold shrink-0" style="background:var(--color-accent);">2</span>
        <div>
          <h2 class="font-heading font-bold text-lg" style="color:var(--color-primary);">Foto Profil UMKM</h2>
          <p class="text-xs text-text-muted">
            Foto toko, tempat usaha, atau foto profil UMKM.
            <strong class="text-ink">Bukan foto produk.</strong>
          </p>
        </div>
      </div>
      <div class="p-6">
        <AdminFotoManager
          ownerType="umkm"
          ownerId={umkm.id}
          mediaList={mediaList}
          purgePaths={['/', '/umkm', `/umkm/${umkm.slug}`, '/peta']}
          defaultAlt={umkm.nama}
        />
      </div>
    </section>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         BAGIAN 3 — KATALOG PRODUK
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <section class="bg-white rounded-xl border border-border shadow-sm overflow-hidden">
      <div class="flex items-center gap-3 px-6 py-4 border-b border-border" style="background:var(--color-sand);">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-sm font-bold shrink-0" style="background:var(--color-cta);">3</span>
        <div>
          <h2 class="font-heading font-bold text-lg" style="color:var(--color-primary);">Katalog Produk <span class="text-text-muted font-normal text-base">({products.length})</span></h2>
          <p class="text-xs text-text-muted">
            Tambah produk yang dijual oleh <strong class="text-ink">{umkm.nama}</strong>.
            Foto produk diupload di dalam setiap produk.
          </p>
        </div>
      </div>

      <div class="p-6 space-y-6">
        <!-- List Produk Saat Ini -->
        {products.length === 0 ? (
          <div class="p-6 text-center text-text-muted bg-sand/30 rounded-lg text-sm">
            Toko ini belum memiliki produk terdaftar. Tambahkan produk pertama di bawah.
          </div>
        ) : (
          <div class="space-y-4">
            {productsWithMedia.map(p => (
              <div class="rounded-lg border border-border bg-sand/20 p-3">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <h4 class="font-heading font-semibold text-sm text-ink">{p.nama}</h4>
                    <p class="text-xs font-bold text-accent">{formatRupiah(p.harga)}</p>
                  </div>
                  <div class="flex items-center gap-2">
                    <a href={`/produk/${p.slug}`} target="_blank"
                      class="px-2.5 py-1 rounded text-xs font-medium border border-border hover:bg-white">
                      Lihat
                    </a>
                    <form method="POST" action="/api/admin/produk/delete" onsubmit="return confirm('Hapus produk ini?')">
                      <input type="hidden" name="id" value={p.id} />
                      <input type="hidden" name="umkm_id" value={umkm.id} />
                      <button type="submit" class="px-2.5 py-1 rounded text-xs font-medium text-red-600 border border-red-200 hover:bg-red-50">
                        Hapus
                      </button>
                    </form>
                  </div>
                </div>

                <AdminFotoManager
                  ownerType="produk"
                  ownerId={p.id}
                  mediaList={p.mediaList}
                  purgePaths={['/', '/umkm', `/umkm/${umkm.slug}`, `/produk/${p.slug}`]}
                  defaultAlt={`${p.nama} - ${umkm.nama}`}
                  title="Foto Produk"
                  subtitle="Unggah foto katalog untuk produk ini. Foto pertama otomatis menjadi sampul produk."
                  buttonLabel="+ Tambah Foto Produk"
                />
              </div>
            ))}
          </div>
        )}

        <!-- Form Tambah Produk Baru -->
        <div class="rounded-xl border-2 border-dashed p-5 space-y-4" style="border-color:var(--color-border);">
          <div class="flex items-center gap-2">
            <span class="font-heading font-semibold text-sm" style="color:var(--color-cta);">+ Tambah Produk Baru</span>
            <span class="text-xs text-text-muted">— isi nama, harga, dan deskripsi singkat. Foto produk dapat ditambahkan setelah produk disimpan.</span>
          </div>
          <form method="POST" action="/api/admin/produk" class="space-y-4">
            <input type="hidden" name="umkm_id" value={umkm.id} />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-heading font-medium mb-1">Nama Produk <span class="text-red-500">*</span></label>
                <input type="text" name="nama" required placeholder="mis. Lampion Bambu Minimalis"
                  class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none"
                  style="border-color:var(--color-border); min-height:40px;" />
              </div>
              <div>
                <label class="block text-xs font-heading font-medium mb-1">Harga (Rp) <span class="text-red-500">*</span></label>
                <input type="number" name="harga" required placeholder="mis. 75000"
                  class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none"
                  style="border-color:var(--color-border); min-height:40px;" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-heading font-medium mb-1">Deskripsi Singkat Produk</label>
              <textarea name="deskripsi_html" rows={2} placeholder="Ringkasan atau spesifikasi produk..."
                class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none"
                style="border-color:var(--color-border);"></textarea>
            </div>

            <div class="flex justify-end">
              <button type="submit" class="px-4 py-2 rounded-lg font-heading font-semibold text-white text-xs cursor-pointer hover:opacity-90" style="background:var(--color-cta);">
                + Tambahkan Produk
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

  </div>

</AdminLayout>

<style>
  #editor h2 { font-size:1.125rem; font-weight:700; margin:1rem 0 .25rem; }
  #editor ul { list-style:disc; padding-left:1.5rem; }
  #editor ol { list-style:decimal; padding-left:1.5rem; }
</style>

<script>
  import { initEditor } from '../../../scripts/admin-editor';

  const editor = document.getElementById('editor') as HTMLDivElement;
  const hidden = document.getElementById('deskripsi_html') as HTMLInputElement;
  document.querySelector('form')?.addEventListener('submit', () => { hidden.value = editor.innerHTML; });
  initEditor(editor, hidden);
</script>
