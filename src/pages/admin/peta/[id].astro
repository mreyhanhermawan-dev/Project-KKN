---
import AdminLayout from '../../../components/AdminLayout.astro';
import { getTitikPetaById } from '../../../lib/db/titik-peta';

const { id } = Astro.params as { id: string };
import { getEnv } from '@lib/env';
const env = getEnv();
const titik = env ? await getTitikPetaById(Number(id), env.DB) : null;
if (!titik) return Astro.redirect('/admin/peta');

const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');

const titikJson = JSON.stringify([titik]);
---

<AdminLayout title={`Edit Titik: ${titik.label || titik.linked_slug}`} breadcrumb={`Peta / Edit`}>

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Perubahan titik peta berhasil disimpan.
    </div>
  )}
  {error && (
    <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FECACA;">
      ⚠️ Gagal menyimpan titik peta. Pastikan semua kolom wajib diisi.
    </div>
  )}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Map picker -->
    <div>
      <h2 class="font-heading font-bold text-xl mb-4" style="color:var(--color-primary);">Pilih Lokasi</h2>
      <div id="admin-map" class="w-full rounded-xl border border-border overflow-hidden relative z-0" style="height:400px;"></div>
      <p class="text-xs text-text-muted mt-2">Klik peta untuk mengubah koordinat.</p>
    </div>

    <!-- Edit form -->
    <div>
      <h3 class="font-heading font-semibold text-lg mb-4" style="color:var(--color-primary);">Detail Titik</h3>
      <form method="POST" action={`/api/admin/peta/${titik.id}`} class="space-y-4">
        <div>
          <label for="label" class="block font-heading font-medium text-sm mb-1.5">Label</label>
          <input type="text" id="label" name="label" value={titik.label ?? ''}
            class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
            style="border-color:var(--color-border); min-height:44px;" placeholder="cth. Pantai Loji" />
        </div>
        <div>
          <label for="jenis" class="block font-heading font-medium text-sm mb-1.5">Jenis <span>*</span></label>
          <select id="jenis" name="jenis" required
            class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
            style="border-color:var(--color-border); min-height:44px;">
            <option value="pemerintahan" selected={titik.jenis === 'pemerintahan'}>Pemerintahan</option>
            <option value="wisata" selected={titik.jenis === 'wisata'}>Wisata</option>
            <option value="umkm" selected={titik.jenis === 'umkm'}>UMKM</option>
            <option value="potensi" selected={titik.jenis === 'potensi'}>Potensi</option>
          </select>
        </div>
        <div>
          <label for="linked_slug" class="block font-heading font-medium text-sm mb-1.5">Slug Entitas <span>*</span></label>
          <input type="text" id="linked_slug" name="linked_slug" value={titik.linked_slug} required
            class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
            style="border-color:var(--color-border); min-height:44px;" placeholder="cth. pantai-loji" />
        </div>
        <div>
          <label for="desc" class="block font-heading font-medium text-sm mb-1.5">Deskripsi Singkat</label>
          <input type="text" id="desc" name="desc" value={titik.desc ?? ''}
            class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
            style="border-color:var(--color-border); min-height:44px;" placeholder="cth. Garis pantai ±4 km di tepi Samudra Hindia" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="lat" class="block font-heading font-medium text-sm mb-1.5">Lintang <span>*</span></label>
            <input type="number" id="lat" name="lat" step="any" value={titik.lat} required
              class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
              style="border-color:var(--color-border); min-height:44px;" />
          </div>
          <div>
            <label for="lng" class="block font-heading font-medium text-sm mb-1.5">Bujur <span>*</span></label>
            <input type="number" id="lng" name="lng" step="any" value={titik.lng} required
              class="w-full rounded-lg border px-4 py-2.5 text-base focus:outline-none"
              style="border-color:var(--color-border); min-height:44px;" />
          </div>
        </div>
        
        <div class="pt-2 flex justify-end gap-3">
          <a href="/admin/peta"
            class="px-4 py-2 rounded-lg font-heading font-medium text-sm border transition-colors hover:bg-sand"
            style="border-color:var(--color-border); min-height:44px; display:flex; align-items:center;">
            Batal
          </a>
          <button type="submit"
            class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer"
            style="background:var(--color-cta); min-height:44px;">
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script is:inline define:vars={{ titikJson, tLat: titik.lat, tLng: titik.lng }}>
  document.addEventListener('DOMContentLoaded', () => {
    const titiks = JSON.parse(titikJson);
    const map = L.map('admin-map').setView([tLat, tLng], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    const colors = { wisata: '#0E9AA7', umkm: '#15803D', potensi: '#0E4A6E', pemerintahan: '#E11D48' };
    
    // Create initial marker
    let marker = L.circleMarker([tLat, tLng], {
      radius: 8, fillColor: colors[titiks[0].jenis] ?? '#666', color: '#fff',
      weight: 2, opacity: 1, fillOpacity: 0.9
    }).addTo(map);

    map.on('click', (e) => {
      document.getElementById('lat').value = e.latlng.lat.toFixed(6);
      document.getElementById('lng').value = e.latlng.lng.toFixed(6);
      
      // Update marker position
      if (marker) map.removeLayer(marker);
      const jenis = document.getElementById('jenis').value;
      marker = L.circleMarker([e.latlng.lat, e.latlng.lng], {
        radius: 8, fillColor: colors[jenis] ?? '#666', color: '#fff',
        weight: 2, opacity: 1, fillOpacity: 0.9
      }).addTo(map);
    });
    
    document.getElementById('jenis').addEventListener('change', (e) => {
       if(marker) {
          marker.setStyle({ fillColor: colors[e.target.value] ?? '#666' });
       }
    });
  });
</script>
