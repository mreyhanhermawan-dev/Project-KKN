---
import AdminLayout from '../../../../components/AdminLayout.astro';
import { getLayananData } from '../../../../lib/db/layanan';
import { getEnv } from '@lib/env';

const { catIndex, itemIndex } = Astro.params as { catIndex: string; itemIndex: string };
const cIdx = Number(catIndex);
const iIdx = Number(itemIndex);

const env = getEnv();
const data = env ? await getLayananData(env.DB) : [];
const cat = data[cIdx];
const item = cat?.items?.[iIdx];
if (!cat || !item) return Astro.redirect('/admin/layanan?error=1');
---

<AdminLayout title="Sunting Layanan" breadcrumb="Layanan / Sunting">
  <div class="max-w-3xl">
    <h2 class="font-heading font-bold text-xl mb-6" style="color:var(--color-primary);">Sunting Layanan</h2>

    <form method="POST" action="/api/admin/layanan" class="space-y-5">
      <input type="hidden" name="_action" value="update" />
      <input type="hidden" name="cat_index" value={cIdx} />
      <input type="hidden" name="item_index" value={iIdx} />
      <input type="hidden" name="back" value="/admin/layanan?saved=1" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="cat_id" class="block font-heading font-medium text-sm mb-1.5">Kategori ID *</label>
          <input id="cat_id" name="cat_id" required value={cat.id}
            class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
        </div>
        <div>
          <label for="cat_icon" class="block font-heading font-medium text-sm mb-1.5">Icon Lucide *</label>
          <input id="cat_icon" name="cat_icon" required value={cat.icon}
            class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
        </div>
      </div>

      <div>
        <label for="cat_title" class="block font-heading font-medium text-sm mb-1.5">Nama Kategori *</label>
        <input id="cat_title" name="cat_title" required value={cat.title}
          class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
      </div>

      <div>
        <label for="cat_description" class="block font-heading font-medium text-sm mb-1.5">Deskripsi Kategori *</label>
        <input id="cat_description" name="cat_description" required value={cat.description}
          class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
      </div>

      <hr class="border-border" />

      <div>
        <label for="nama" class="block font-heading font-medium text-sm mb-1.5">Nama Layanan *</label>
        <input id="nama" name="nama" required value={item.nama}
          class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
      </div>

      <div>
        <label for="deskripsi" class="block font-heading font-medium text-sm mb-1.5">Deskripsi Layanan *</label>
        <textarea id="deskripsi" name="deskripsi" rows="4" required
          class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border);">{item.deskripsi}</textarea>
      </div>

      <div>
        <label for="syarat_raw" class="block font-heading font-medium text-sm mb-1.5">Syarat (satu baris satu syarat)</label>
        <textarea id="syarat_raw" name="syarat_raw" rows="5"
          class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border);">{item.syarat.join('\n')}</textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="estimasi" class="block font-heading font-medium text-sm mb-1.5">Estimasi</label>
          <input id="estimasi" name="estimasi" value={item.estimasi}
            class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
        </div>
        <div>
          <label for="biaya" class="block font-heading font-medium text-sm mb-1.5">Biaya</label>
          <input id="biaya" name="biaya" value={item.biaya}
            class="w-full rounded-lg border px-4 py-3 text-base" style="border-color:var(--color-border); min-height:44px;" />
        </div>
      </div>

      <div class="sticky bottom-0 bg-white border-t border-border -mx-4 md:-mx-6 px-4 md:px-6 py-3 flex justify-end gap-3" style="box-shadow:0 -2px 8px rgba(0,0,0,.06);">
        <a href="/admin/layanan" class="px-4 py-2 rounded-lg font-heading font-medium text-sm border hover:bg-sand" style="border-color:var(--color-border); min-height:44px; display:flex; align-items:center;">Batal</a>
        <button type="submit" class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm" style="background:var(--color-cta); min-height:44px;">Simpan</button>
      </div>
    </form>
  </div>
</AdminLayout>
