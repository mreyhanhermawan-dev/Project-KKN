---
import AdminLayout from '../../../components/AdminLayout.astro';
import AdminEditorToolbar from '../../../components/AdminEditorToolbar.astro';
import { getSection } from '../../../lib/db/page-section';

const { slug } = Astro.params as { slug: string };
import { getEnv } from '@lib/env';
const env = getEnv();

const section = env ? await getSection(slug, env.DB) : null;
if (!section) return Astro.redirect('/admin/konten');

const saved = Astro.url.searchParams.get('saved');
const sectionLabel = slug === 'beranda-sekilas' ? 'Beranda: Sambutan Kepala Kelurahan' : slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

let lurahNama = '';
let lurahJabatan = '';

if (slug === 'beranda-sekilas') {
  if (section.cover_alt) {
    try {
      const parsed = JSON.parse(section.cover_alt);
      lurahNama = parsed.nama || '';
      lurahJabatan = parsed.jabatan || '';
    } catch {
      lurahNama = section.cover_alt || '';
      lurahJabatan = 'Kepala Kelurahan Palabuhanratu';
    }
  } else {
    lurahNama = 'H. Ahmad Sobirin, S.IP., M.Si.';
    lurahJabatan = 'Kepala Kelurahan Palabuhanratu';
  }
}
---

<AdminLayout title={`Edit: ${sectionLabel}`} breadcrumb={`Konten / ${sectionLabel}`}>

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Konten berhasil disimpan.
    </div>
  )}

  <div class="max-w-3xl">
    <h2 class="font-heading font-bold text-xl mb-6" style="color:var(--color-primary);">{sectionLabel}</h2>

    <form method="POST" action="/api/admin/konten" class="space-y-5">
      <input type="hidden" name="slug" value={slug} />

      <div>
        <label for="title" class="block font-heading font-medium text-sm mb-1.5">
          Judul <span>*</span> <span class="font-normal text-text-muted">(wajib)</span>
        </label>
        <input
          type="text" id="title" name="title" required
          value={section.title}
          class="w-full rounded-lg border px-4 py-3 text-base focus:outline-none"
          style="border-color:var(--color-border); min-height:44px;"
        />
      </div>

      {slug === 'beranda-sekilas' && (
        <div class="space-y-4 p-5 border border-border rounded-xl bg-slate-50/50">
          <h3 class="font-heading font-bold text-sm text-primary">Detail Kepala Kelurahan</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="lurah_nama" class="block font-heading font-medium text-xs mb-1.5">Nama Kepala Kelurahan</label>
              <input
                type="text" id="lurah_nama" value={lurahNama}
                class="w-full rounded-lg border px-3 py-2 text-sm focus:outline-none bg-white"
                style="border-color:var(--color-border); min-height:40px;"
              />
            </div>
            <div>
              <label for="lurah_jabatan" class="block font-heading font-medium text-xs mb-1.5">Jabatan / Gelar</label>
              <input
                type="text" id="lurah_jabatan" value={lurahJabatan}
                class="w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none bg-white"
                style="border-color:var(--color-border); min-height:40px;"
              />
            </div>
          </div>

          <div>
            <label class="block font-heading font-medium text-xs mb-1.5">Foto Kepala Kelurahan</label>
            <div class="flex items-center gap-4">
              <img
                id="lurah_preview"
                src={section.cover_r2_key ? (section.cover_r2_key.startsWith('/') ? section.cover_r2_key : `/api/media/${encodeURIComponent(section.cover_r2_key)}`) : '/images/lurah.png'}
                alt="Foto Lurah"
                class="w-24 h-24 object-cover rounded-xl border border-slate-200 bg-white shadow-sm"
              />
              <div class="flex flex-col gap-2">
                <label class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg font-heading font-semibold text-xs border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition-colors" style="min-height:36px;">
                  Ganti Foto
                  <input type="file" id="lurah_photo_file" accept="image/*" class="hidden" />
                </label>
                <p id="upload_status" class="text-[11px] text-text-muted"></p>
                <input type="hidden" name="cover_r2_key" id="cover_r2_key" value={section.cover_r2_key || ''} />
              </div>
            </div>
          </div>
          
          <input type="hidden" name="cover_alt" id="cover_alt_input" value={section.cover_alt || ''} />
        </div>
      )}

      {slug === 'pemerintahan-tugas-fungsi' && (
        <div class="space-y-4 p-5 border border-border rounded-xl bg-slate-50/50">
          <h3 class="font-heading font-bold text-sm text-primary">Daftar Kartu Tugas & Fungsi</h3>
          <p class="text-xs text-text-muted">Tambahkan, ubah, atau hapus kartu tugas dan fungsi perangkat di bawah ini.</p>
          
          <div id="duties_container" class="space-y-3">
            {/* Populated dynamically by JavaScript */}
          </div>
          
          <button type="button" id="add_duty_btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-heading font-semibold text-xs border border-dashed border-slate-300 bg-white hover:bg-slate-50 transition-colors cursor-pointer" style="min-height:32px;">
            + Tambah Kartu Jabatan
          </button>
          
          <input type="hidden" name="cover_alt" id="cover_alt_input" value={section.cover_alt || ''} />
        </div>
      )}

      {slug === 'pemerintahan-struktur' && (
        <div class="space-y-4 p-5 border border-border rounded-xl bg-slate-50/50">
          <h3 class="font-heading font-bold text-sm text-primary">Bagan Struktur Organisasi</h3>
          <p class="text-xs text-text-muted">Unggah gambar bagan struktur organisasi Pemerintah Kelurahan Palabuhanratu di bawah ini.</p>
          
          <div>
            <div class="flex flex-col gap-4">
              <img
                id="struktur_preview"
                src={section.cover_r2_key ? (section.cover_r2_key.startsWith('/') ? section.cover_r2_key : `/api/media/${encodeURIComponent(section.cover_r2_key)}`) : '/images/struktur_organisasi.png'}
                alt="Bagan Struktur Organisasi"
                class="w-full max-w-lg object-contain rounded-xl border border-slate-200 bg-white shadow-sm"
              />
              <div class="flex flex-col gap-2">
                <label class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg font-heading font-semibold text-xs border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition-colors self-start" style="min-height:36px;">
                  Unggah Gambar Struktur
                  <input type="file" id="struktur_file" accept="image/*" class="hidden" />
                </label>
                <p id="struktur_upload_status" class="text-[11px] text-text-muted"></p>
                <input type="hidden" name="cover_r2_key" id="cover_r2_key" value={section.cover_r2_key || ''} />
              </div>
            </div>
          </div>
        </div>
      )}

      <div>
        <label for="content_html" class="block font-heading font-medium text-sm mb-1.5">
          Konten
        </label>
        <AdminEditorToolbar withImage />

        <div
          id="editor"
          contenteditable="true"
          class="w-full min-h-48 border border-t-0 rounded-b-lg px-4 py-3 text-base focus:outline-none prose max-w-none"
          style="border-color:var(--color-border);"
          set:html={section.content_html}
        ></div>
        <input type="hidden" id="content_html" name="content_html" value={section.content_html} />
      </div>

      <!-- Sticky action bar -->
      <div class="sticky bottom-0 bg-white border-t border-border -mx-4 md:-mx-6 px-4 md:px-6 py-3 flex justify-end gap-3" style="box-shadow:0 -2px 8px rgba(0,0,0,.06);">
        <a href="/admin/konten"
          class="px-4 py-2 rounded-lg font-heading font-medium text-sm border transition-colors hover:bg-sand cursor-pointer focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent"
          style="border-color:var(--color-border); min-height:44px; display:flex; align-items:center;">
          Batal
        </a>
        <button type="submit"
          class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent"
          style="background:var(--color-cta); min-height:44px;">
          Simpan
        </button>
      </div>
    </form>
  </div>

</AdminLayout>

<style>
  #editor h2 { font-size:1.25rem; font-weight:700; margin:1rem 0 .5rem; }
  #editor ul { list-style:disc; padding-left:1.5rem; }
  #editor ol { list-style:decimal; padding-left:1.5rem; }
  #editor p { margin:.25rem 0; }
  #editor img { max-width:100%; height:auto; border-radius:.5rem; margin:.5rem 0; }
</style>

<script>
  import { initEditor } from '../../../scripts/admin-editor';

  const editor = document.getElementById('editor') as HTMLDivElement;
  const hidden = document.getElementById('content_html') as HTMLInputElement;

  // Handle lurah welcome photo upload
  const lurahPhotoFile = document.getElementById('lurah_photo_file') as HTMLInputElement;
  const lurahPreview = document.getElementById('lurah_preview') as HTMLImageElement;
  const coverR2KeyInput = document.getElementById('cover_r2_key') as HTMLInputElement;
  const uploadStatus = document.getElementById('upload_status') as HTMLParagraphElement;

  if (lurahPhotoFile) {
    lurahPhotoFile.addEventListener('change', async () => {
      const file = lurahPhotoFile.files?.[0];
      if (!file) return;

      if (uploadStatus) uploadStatus.textContent = 'Mengunggah foto...';
      try {
        const { uploadImage } = await import('../../../scripts/admin-editor');
        const res = await uploadImage(file, 'Foto Kepala Kelurahan', {
          purge: '/'
        });
        
        // Save the key part from R2 instead of full URL path
        const key = res.url.replace('/api/media/', '');
        if (coverR2KeyInput) coverR2KeyInput.value = key;
        if (lurahPreview) lurahPreview.src = res.url;
        if (uploadStatus) uploadStatus.textContent = 'Foto berhasil diunggah.';
      } catch (err) {
        console.error(err);
        if (uploadStatus) uploadStatus.textContent = 'Upload gagal. Coba lagi.';
      }
    });
  }

  // Handle Struktur Organisasi image upload
  const strukturFile = document.getElementById('struktur_file') as HTMLInputElement;
  const strukturPreview = document.getElementById('struktur_preview') as HTMLImageElement;
  const strukturUploadStatus = document.getElementById('struktur_upload_status') as HTMLParagraphElement;

  if (strukturFile) {
    strukturFile.addEventListener('change', async () => {
      const file = strukturFile.files?.[0];
      if (!file) return;

      if (strukturUploadStatus) strukturUploadStatus.textContent = 'Mengunggah gambar...';
      try {
        const { uploadImage } = await import('../../../scripts/admin-editor');
        const res = await uploadImage(file, 'Bagan Struktur Organisasi', {
          purge: '/'
        });
        
        const key = res.url.replace('/api/media/', '');
        if (coverR2KeyInput) coverR2KeyInput.value = key;
        if (strukturPreview) strukturPreview.src = res.url;
        if (strukturUploadStatus) strukturUploadStatus.textContent = 'Gambar bagan berhasil diunggah.';
      } catch (err) {
        console.error(err);
        if (strukturUploadStatus) strukturUploadStatus.textContent = 'Upload gagal. Coba lagi.';
      }
    });
  }

  // Handle Tugas & Fungsi card list editor
  const dutiesContainer = document.getElementById('duties_container');
  const addDutyBtn = document.getElementById('add_duty_btn');
  const coverAltInput = document.getElementById('cover_alt_input') as HTMLInputElement;

  if (dutiesContainer && addDutyBtn && coverAltInput) {
    let duties: { icon: string; title: string; desc: string }[] = [];
    try {
      duties = JSON.parse(coverAltInput.value);
    } catch {
      // Default list if empty or invalid JSON
      duties = [
        { icon: 'user-round', title: 'Kepala Kelurahan', desc: 'Memimpin penyelenggaraan pemerintahan, pembangunan, dan pemberdayaan masyarakat kelurahan.' },
        { icon: 'clipboard-list', title: 'Sekretaris Kelurahan', desc: 'Membantu kepala kelurahan di bidang administrasi dan tata usaha pemerintahan.' },
        { icon: 'wallet', title: 'Kaur Keuangan', desc: 'Mengelola keuangan dan penatausahaan anggaran kelurahan.' },
        { icon: 'landmark', title: 'Kasi Pemerintahan', desc: 'Melaksanakan urusan pemerintahan, kependudukan, dan pertanahan.' },
        { icon: 'heart-handshake', title: 'Kasi Kesejahteraan', desc: 'Melaksanakan pemberdayaan masyarakat dan kesejahteraan sosial.' },
        { icon: 'clipboard-check', title: 'Kasi Pelayanan', desc: 'Menyelenggarakan pelayanan kepada masyarakat kelurahan.' }
      ];
    }

    const availableIcons = [
      { value: 'user-round', label: 'User / Orang' },
      { value: 'clipboard-list', label: 'Daftar / List' },
      { value: 'wallet', label: 'Dompet / Keuangan' },
      { value: 'landmark', label: 'Gedung / Pemerintahan' },
      { value: 'heart-handshake', label: 'Kesejahteraan / Sosial' },
      { value: 'clipboard-check', label: 'Pelayanan / Centang' },
      { value: 'users', label: 'Masyarakat / Grup' },
      { value: 'layers', label: 'Ruang Lingkup / Lapisan' },
      { value: 'shield', label: 'Keamanan / Shield' },
      { value: 'book-open', label: 'Pendidikan / Buku' },
      { value: 'briefcase', label: 'Pekerjaan / Bisnis' },
      { value: 'map-pin', label: 'Lokasi / Peta' },
      { value: 'info', label: 'Informasi' },
      { value: 'file-text', label: 'Dokumen' }
    ];

    const renderDuties = () => {
      dutiesContainer.innerHTML = '';
      duties.forEach((duty, index) => {
        const itemDiv = document.createElement('div');
        itemDiv.className = 'flex flex-col md:flex-row gap-3 p-4 bg-white border border-slate-200 rounded-lg relative';
        
        let selectHtml = `<select class="duty-icon w-full md:w-40 rounded-lg border border-slate-200 px-2 py-1.5 text-xs bg-white focus:outline-none" style="min-height:36px;">`;
        availableIcons.forEach(icon => {
          selectHtml += `<option value="${icon.value}" ${duty.icon === icon.value ? 'selected' : ''}>${icon.label}</option>`;
        });
        selectHtml += `</select>`;

        itemDiv.innerHTML = `
          <div class="flex-1 space-y-2">
            <div class="flex gap-2">
              <div class="w-1/3 min-w-[120px]">
                <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">Ikon</label>
                ${selectHtml}
              </div>
              <div class="flex-1">
                <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">Nama Jabatan</label>
                <input type="text" class="duty-title w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:outline-none" style="min-height:36px;" value="${duty.title || ''}" />
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold text-slate-500 uppercase mb-0.5">Deskripsi Peran</label>
              <textarea class="duty-desc w-full rounded-lg border border-slate-200 px-3 py-1.5 text-xs focus:outline-none min-h-16" style="resize:vertical;">${duty.desc || ''}</textarea>
            </div>
          </div>
          <div class="flex items-end justify-end md:self-start md:mt-4">
            <button type="button" class="remove-duty-btn px-2.5 py-1.5 rounded-lg border border-red-200 hover:bg-red-50 text-red-600 text-xs font-semibold cursor-pointer">
              Hapus
            </button>
          </div>
        `;

        const titleInput = itemDiv.querySelector('.duty-title') as HTMLInputElement;
        const descInput = itemDiv.querySelector('.duty-desc') as HTMLTextAreaElement;
        const iconSelect = itemDiv.querySelector('.duty-icon') as HTMLSelectElement;
        const removeBtn = itemDiv.querySelector('.remove-duty-btn') as HTMLButtonElement;

        const updateData = () => {
          duties[index] = {
            icon: iconSelect.value,
            title: titleInput.value,
            desc: descInput.value
          };
          coverAltInput.value = JSON.stringify(duties);
        };

        titleInput.addEventListener('input', updateData);
        descInput.addEventListener('input', updateData);
        iconSelect.addEventListener('change', updateData);
        
        removeBtn.addEventListener('click', () => {
          duties.splice(index, 1);
          coverAltInput.value = JSON.stringify(duties);
          renderDuties();
        });

        dutiesContainer.appendChild(itemDiv);
      });
    };

    addDutyBtn.addEventListener('click', () => {
      duties.push({ icon: 'user-round', title: 'Jabatan Baru', desc: 'Deskripsi tugas jabatan baru.' });
      coverAltInput.value = JSON.stringify(duties);
      renderDuties();
    });

    renderDuties();
  }

  document.querySelector('form')?.addEventListener('submit', () => {
    hidden.value = editor.innerHTML;

    // Sync metadata inputs
    const namaInput = document.getElementById('lurah_nama') as HTMLInputElement;
    const jabatanInput = document.getElementById('lurah_jabatan') as HTMLInputElement;
    const coverAltInput = document.getElementById('cover_alt_input') as HTMLInputElement;
    if (namaInput && jabatanInput && coverAltInput) {
      coverAltInput.value = JSON.stringify({
        nama: namaInput.value,
        jabatan: jabatanInput.value
      });
    }
  });
  
  initEditor(editor, hidden);
</script>
