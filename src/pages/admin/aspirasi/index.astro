---
import AdminLayout from '../../../components/AdminLayout.astro';
import { getAllAspirasi } from '../../../lib/db/aspirasi';
import { getEnv } from '@lib/env';

const env = getEnv();
const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');

const list = env ? await getAllAspirasi(env.DB) : [];

const search = Astro.url.searchParams.get('q') || '';
const startDate = Astro.url.searchParams.get('startDate') || '';
const endDate = Astro.url.searchParams.get('endDate') || '';
const month = Astro.url.searchParams.get('month') || '';

let filteredList = list;

if (search) {
  const q = search.toLowerCase();
  filteredList = filteredList.filter(item => 
    item.nama.toLowerCase().includes(q) || 
    (item.kontak && item.kontak.toLowerCase().includes(q)) ||
    item.isi.toLowerCase().includes(q)
  );
}

if (startDate) {
  filteredList = filteredList.filter(item => item.created_at.slice(0, 10) >= startDate);
}
if (endDate) {
  filteredList = filteredList.filter(item => item.created_at.slice(0, 10) <= endDate);
}
if (month) {
  filteredList = filteredList.filter(item => item.created_at.slice(0, 7) === month);
}
---

<AdminLayout title="Aspirasi Masyarakat" breadcrumb="Aspirasi Masyarakat">
  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Perubahan berhasil disimpan.
    </div>
  )}
  {error && (
    <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FCA5A5;">
      Terjadi kesalahan. Coba lagi.
    </div>
  )}

  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <h2 class="font-heading font-bold text-xl" style="color:var(--color-primary);">Inbox Aspirasi Warga</h2>
      <p class="text-xs text-text-muted mt-0.5">
        {(search || startDate || endDate || month) 
          ? `Hasil Filter: ${filteredList.length} dari ${list.length} aspirasi` 
          : `Total: ${list.length} aspirasi masuk`}
      </p>
    </div>
    {filteredList.length > 0 && (
      <a href={`/api/admin/aspirasi?q=${encodeURIComponent(search)}&startDate=${startDate}&endDate=${endDate}&month=${month}`} 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg font-heading font-semibold text-sm text-white focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-accent hover:opacity-90 transition-opacity"
        style="background:var(--color-primary);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Unduh Excel / CSV
      </a>
    )}
  </div>

  <!-- Filter & Search Panel -->
  <div class="bg-white rounded-xl border border-border p-5 mb-6" style="box-shadow:var(--shadow-sm);">
    <form method="GET" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Search Input -->
        <div>
          <label for="q" class="block font-heading font-medium text-xs text-text-muted mb-1">Cari Pengirim / Kontak</label>
          <input 
            type="text" id="q" name="q" value={search} placeholder="Nama, email, nomor HP..." 
            class="w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none" style="min-height:40px;" 
          />
        </div>

        <!-- Filter Type Select -->
        <div>
          <label for="filter_type" class="block font-heading font-medium text-xs text-text-muted mb-1">Jenis Filter Tanggal</label>
          <select id="filter_type" class="w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none bg-white" style="min-height:40px;">
            <option value="all" selected={!startDate && !endDate && !month}>Semua Waktu</option>
            <option value="daily" selected={!!startDate || !!endDate}>Harian (Rentang Tanggal)</option>
            <option value="monthly" selected={!!month}>Bulanan</option>
          </select>
        </div>

        <!-- Daily Fields -->
        <div id="daily_fields" class="grid grid-cols-2 gap-2" style={(!startDate && !endDate) ? "display:none;" : ""}>
          <div>
            <label for="startDate" class="block font-heading font-medium text-xs text-text-muted mb-1">Mulai</label>
            <input 
              type="date" id="startDate" name="startDate" value={startDate} 
              class="w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none" style="min-height:40px;" 
            />
          </div>
          <div>
            <label for="endDate" class="block font-heading font-medium text-xs text-text-muted mb-1">Selesai</label>
            <input 
              type="date" id="endDate" name="endDate" value={endDate} 
              class="w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none" style="min-height:40px;" 
            />
          </div>
        </div>

        <!-- Monthly Field -->
        <div id="monthly_fields" style={!month ? "display:none;" : ""}>
          <label for="month" class="block font-heading font-medium text-xs text-text-muted mb-1">Pilih Bulan</label>
          <input 
            type="month" id="month" name="month" value={month} 
            class="w-full rounded-lg border border-border px-3 py-2 text-sm focus:outline-none" style="min-height:40px;" 
          />
        </div>
      </div>

      <div class="flex justify-end gap-2 border-t border-slate-100 pt-3">
        {(search || startDate || endDate || month) && (
          <a href="/admin/aspirasi" class="px-4 py-2 rounded-lg font-heading font-medium text-xs border border-border hover:bg-slate-50 transition-colors" style="display:inline-flex; align-items:center; min-height:36px;">
            Reset Filter
          </a>
        )}
        <button type="submit" class="px-4 py-2 rounded-lg font-heading font-semibold text-white text-xs hover:opacity-90 transition-opacity cursor-pointer" style="background:var(--color-primary); min-height:36px;">
          Terapkan Filter
        </button>
      </div>
    </form>
  </div>

  <div class="bg-white rounded-xl border border-border overflow-hidden" style="box-shadow:var(--shadow-sm);">
    {filteredList.length === 0 ? (
      <div class="p-8 text-center text-text-muted">
        <p>{list.length === 0 ? 'Belum ada aspirasi masuk.' : 'Tidak ada data aspirasi yang cocok dengan filter pencarian.'}</p>
      </div>
    ) : (
      <div class="divide-y divide-border">
        {filteredList.map((a) => (
          <article class="p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h3 class="font-heading font-semibold text-base">{a.nama}</h3>
                  <span class:list={[
                    'px-2 py-0.5 rounded-full text-[11px] font-heading font-semibold',
                    a.status === 'baru' ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'
                  ]}>
                    {a.status === 'baru' ? 'Baru' : 'Dibaca'}
                  </span>
                </div>
                <p class="text-xs text-text-muted">{a.kontak || 'Kontak tidak diisi'} • {new Date(a.created_at).toLocaleString('id-ID')}</p>
                <p class="text-sm text-text mt-3 whitespace-pre-wrap">{a.isi}</p>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                {a.status === 'baru' && (
                  <form method="POST" action="/api/admin/aspirasi">
                    <input type="hidden" name="_action" value="read" />
                    <input type="hidden" name="id" value={a.id} />
                    <button type="submit" class="px-3 py-1.5 rounded-md text-xs font-heading font-medium border hover:bg-sand cursor-pointer" style="border-color:var(--color-primary); color:var(--color-primary);">
                      Tandai Dibaca
                    </button>
                  </form>
                )}
                <form method="POST" action="/api/admin/aspirasi" onsubmit="return confirm('Hapus aspirasi ini?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={a.id} />
                  <button type="submit" class="px-3 py-1.5 rounded-md text-xs font-heading font-medium border hover:bg-red-600 hover:text-white cursor-pointer" style="border-color:#DC2626; color:#DC2626;">
                    Hapus
                  </button>
                </form>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterType = document.getElementById('filter_type');
    const dailyFields = document.getElementById('daily_fields');
    const monthlyFields = document.getElementById('monthly_fields');
    const startDate = document.getElementById('startDate');
    const endDate = document.getElementById('endDate');
    const month = document.getElementById('month');

    filterType?.addEventListener('change', () => {
      const val = filterType.value;
      if (val === 'all') {
        if (dailyFields) dailyFields.style.display = 'none';
        if (monthlyFields) monthlyFields.style.display = 'none';
        if (startDate) startDate.value = '';
        if (endDate) endDate.value = '';
        if (month) month.value = '';
      } else if (val === 'daily') {
        if (dailyFields) dailyFields.style.display = 'grid';
        if (monthlyFields) monthlyFields.style.display = 'none';
        if (month) month.value = '';
      } else if (val === 'monthly') {
        if (dailyFields) dailyFields.style.display = 'none';
        if (monthlyFields) monthlyFields.style.display = 'block';
        if (startDate) startDate.value = '';
        if (endDate) endDate.value = '';
      }
    });
  });
</script>
