---
import '../../styles/global.css';

// Redirect jika sudah login
import { getEnv } from '@lib/env';
const env = getEnv();
const sessionId = Astro.cookies.get('dl_session')?.value;
if (sessionId && env) {
  const { validateSession } = await import('../../lib/auth/session');
  const user = await validateSession(sessionId, env.SESSION_KV);
  if (user) return Astro.redirect('/admin/dasbor');
}

const sent = Astro.url.searchParams.get('sent');
const error = Astro.url.searchParams.get('error');

const errorMessages: Record<string, string> = {
  not_found: 'Email tidak ditemukan di sistem.',
  invalid: 'Format email tidak valid.',
  '1': 'Terjadi kesalahan. Silakan coba lagi.',
};

const devLink = Astro.url.searchParams.get('dev_link');
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>Lupa Kata Sandi | Panel Admin Kelurahan Palabuhanratu</title>
  <meta name="robots" content="noindex,nofollow" />
</head>
<body class="font-body min-h-screen flex items-center justify-center" style="background:#F1F5F9;">

  <div class="w-full max-w-sm mx-4">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex w-14 h-14 rounded-full items-center justify-center mb-3 font-heading font-bold text-white text-lg" style="background:#0A3650;" aria-hidden="true">DL</div>
      <h1 class="font-heading font-bold text-xl" style="color:#0A3650;">Lupa Kata Sandi</h1>
      <p class="text-text-muted text-sm mt-1">Masukkan email Anda untuk menerima tautan pemulihan</p>
    </div>

    {sent && (
      <div role="alert" class="mb-4 p-4 rounded-lg text-sm font-medium" style="background:#DCFCE7; color:#166534; border:1px solid #BBF7D0;">
        <div class="flex items-start gap-2">
          <span class="text-lg leading-none">✉</span>
          <div>
            <p class="font-semibold">Tautan pemulihan telah dikirim!</p>
            <p class="mt-0.5 text-xs font-normal opacity-80">Periksa kotak masuk email Anda dan ikuti instruksi di dalamnya. Tautan akan kedaluwarsa dalam 15 menit.</p>
          </div>
        </div>
      </div>
    )}

    {error && !sent && (
      <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FECACA;">
        {errorMessages[error] ?? 'Terjadi kesalahan. Silakan coba lagi.'}
      </div>
    )}

    {devLink && (
      <div class="mb-4 p-3 rounded-lg text-xs" style="background:#FEF9C3; color:#713F12; border:1px solid #FDE68A;">
        <p class="font-semibold mb-1">🧪 Mode Dev — Link Reset Password:</p>
        <a href={devLink} class="break-all underline text-blue-700 hover:text-blue-900">{devLink}</a>
      </div>
    )}

    {!sent && (
      <form method="POST" action="/api/admin/lupa-password" class="bg-white rounded-xl p-6" style="box-shadow:var(--shadow-md);">
        <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken} />
        <div class="space-y-4">
          <div>
            <label for="email" class="block font-heading font-medium text-sm mb-1.5" style="color:var(--color-text);">
              Alamat Email <span aria-label="wajib">*</span>
              <span class="font-normal text-text-muted">(wajib)</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="contoh@email.com"
              class="w-full rounded-lg border px-4 py-3 text-base font-body transition-colors duration-150 focus:outline-none focus-visible:ring-2"
              style="border-color:var(--color-border); min-height:44px; --tw-ring-color:var(--color-accent);"
            />
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full rounded-lg font-heading font-semibold text-white py-3 transition-colors duration-150 cursor-pointer"
            style="background:var(--color-cta); min-height:44px;"
          >
            Kirim Tautan Pemulihan
          </button>
        </div>
      </form>
    )}

    <p class="text-center text-xs text-text-muted mt-6">
      Ingat kata sandi? <a href="/admin/login" class="text-accent hover:underline">Kembali ke halaman masuk</a>
    </p>
  </div>

</body>
</html>
