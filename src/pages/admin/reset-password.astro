---
import '../../styles/global.css';

import { getEnv } from '@lib/env';
const env = getEnv();

const token = Astro.url.searchParams.get('token') ?? '';
const error = Astro.url.searchParams.get('error');

// Validate token exists in KV
let tokenValid = false;
if (env && token) {
  const stored = await env.SESSION_KV.get(`pwd_reset:${token}`);
  if (stored) tokenValid = true;
}

const errorMessages: Record<string, string> = {
  expired: 'Tautan pemulihan sudah kedaluwarsa atau tidak valid. Silakan minta tautan baru.',
  mismatch: 'Konfirmasi kata sandi tidak cocok.',
  weak: 'Kata sandi terlalu lemah. Harus minimal 8 karakter dan memenuhi 3 kriteria keamanan.',
  '1': 'Terjadi kesalahan. Silakan coba lagi.',
};
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>Reset Kata Sandi | Panel Admin Kelurahan Palabuhanratu</title>
  <meta name="robots" content="noindex,nofollow" />
</head>
<body class="font-body min-h-screen flex items-center justify-center" style="background:#F1F5F9;">

  <div class="w-full max-w-sm mx-4">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="inline-flex w-14 h-14 rounded-full items-center justify-center mb-3 font-heading font-bold text-white text-lg" style="background:#0A3650;" aria-hidden="true">DL</div>
      <h1 class="font-heading font-bold text-xl" style="color:#0A3650;">Reset Kata Sandi</h1>
      <p class="text-text-muted text-sm mt-1">Masukkan kata sandi baru Anda</p>
    </div>

    {error && (
      <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FECACA;">
        {errorMessages[error] ?? errorMessages['1']}
      </div>
    )}

    {!token || !tokenValid ? (
      <div class="bg-white rounded-xl p-6 text-center" style="box-shadow:var(--shadow-md);">
        <p class="text-4xl mb-3">🔒</p>
        <p class="font-heading font-semibold text-base mb-1" style="color:var(--color-primary);">Tautan Tidak Valid</p>
        <p class="text-sm text-text-muted mb-4">Tautan pemulihan kata sandi ini sudah kedaluwarsa atau tidak valid.</p>
        <a href="/admin/lupa-password"
          class="inline-block w-full rounded-lg font-heading font-semibold text-white py-3 text-center transition-colors duration-150"
          style="background:var(--color-cta);">
          Minta Tautan Baru
        </a>
      </div>
    ) : (
      <form method="POST" action="/api/admin/reset-password" class="bg-white rounded-xl p-6" style="box-shadow:var(--shadow-md);">
        <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken} />
        <input type="hidden" name="token" value={token} />
        <div class="space-y-4">

          <div>
            <label for="new_password" class="block font-heading font-medium text-sm mb-1.5">
              Kata Sandi Baru <span>*</span>
            </label>
            <input type="password" id="new_password" name="new_password" required minlength="8"
              autocomplete="new-password"
              class="w-full rounded-lg border px-4 py-3 text-base"
              style="border-color:var(--color-border); min-height:44px;" />

            <!-- Password Strength Meter -->
            <div class="mt-2.5 space-y-2">
              <div class="flex justify-between items-center text-xs">
                <span class="text-text-muted">Kekuatan Kata Sandi:</span>
                <span id="strength-text" class="font-semibold text-slate-400">Belum diisi</span>
              </div>
              <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                <div id="strength-bar" class="h-full w-0 transition-all duration-300 ease-out bg-slate-400"></div>
              </div>
              <!-- Criteria Checklist -->
              <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] pt-1 border-t border-slate-100 mt-2">
                <div id="crit-length" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                  <span class="status-icon font-bold">▪</span> Minimal 8 karakter
                </div>
                <div id="crit-upper" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                  <span class="status-icon font-bold">▪</span> Huruf Besar (A-Z)
                </div>
                <div id="crit-lower" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                  <span class="status-icon font-bold">▪</span> Huruf Kecil (a-z)
                </div>
                <div id="crit-number" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                  <span class="status-icon font-bold">▪</span> Angka (0-9)
                </div>
                <div id="crit-special" class="flex items-center gap-1.5 text-slate-400 transition-colors col-span-2">
                  <span class="status-icon font-bold">▪</span> Karakter Khusus (@$!%*?&#)
                </div>
              </div>
            </div>
          </div>

          <div>
            <label for="confirm_password" class="block font-heading font-medium text-sm mb-1.5">
              Konfirmasi Kata Sandi <span>*</span>
            </label>
            <input type="password" id="confirm_password" name="confirm_password" required minlength="8"
              autocomplete="new-password"
              class="w-full rounded-lg border px-4 py-3 text-base"
              style="border-color:var(--color-border); min-height:44px;" />
            <p id="confirm-error" class="text-xs text-red-500 mt-1 hidden">Kata sandi tidak cocok.</p>
          </div>

          <button type="submit" id="submit-btn" disabled
            class="w-full rounded-lg font-heading font-semibold text-white py-3 cursor-not-allowed opacity-50 transition-all duration-200"
            style="background:var(--color-cta); min-height:44px;">
            Simpan Kata Sandi Baru
          </button>
        </div>
      </form>
    )}

    <p class="text-center text-xs text-text-muted mt-6">
      <a href="/admin/login" class="text-accent hover:underline">Kembali ke halaman masuk</a>
    </p>
  </div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const pwdIn = document.getElementById('new_password');
    const confirmIn = document.getElementById('confirm_password');
    const confirmErr = document.getElementById('confirm-error');
    const strengthBar = document.getElementById('strength-bar');
    const strengthText = document.getElementById('strength-text');
    const submitBtn = document.getElementById('submit-btn');

    const critLength = document.getElementById('crit-length');
    const critUpper = document.getElementById('crit-upper');
    const critLower = document.getElementById('crit-lower');
    const critNumber = document.getElementById('crit-number');
    const critSpecial = document.getElementById('crit-special');

    if (!pwdIn || !confirmIn || !submitBtn) return;

    let isStrong = false;

    function checkStrength() {
      const val = pwdIn.value;
      if (!val) {
        strengthBar.style.width = '0%';
        strengthBar.style.backgroundColor = '#CBD5E1';
        strengthText.textContent = 'Belum diisi';
        strengthText.className = 'font-semibold text-slate-400';
        isStrong = false;
        resetCrit(critLength); resetCrit(critUpper);
        resetCrit(critLower); resetCrit(critNumber); resetCrit(critSpecial);
        return;
      }

      const checks = {
        length: val.length >= 8,
        upper: /[A-Z]/.test(val),
        lower: /[a-z]/.test(val),
        number: /\d/.test(val),
        special: /[@$!%*?&#_.\-+=~`'":;?,<>|\(\)\[\]\{\}\\\/^\*]/.test(val)
      };

      updateCrit(critLength, checks.length);
      updateCrit(critUpper, checks.upper);
      updateCrit(critLower, checks.lower);
      updateCrit(critNumber, checks.number);
      updateCrit(critSpecial, checks.special);

      const score = Object.values(checks).filter(Boolean).length;

      let color = '#EF4444', text = 'Sangat Lemah', width = '20%', cls = 'text-red-500 font-semibold';
      if (score === 2) { color = '#F97316'; text = 'Lemah'; width = '40%'; cls = 'text-orange-500 font-semibold'; }
      else if (score === 3) { color = '#EAB308'; text = 'Sedang'; width = '65%'; cls = 'text-yellow-600 font-semibold'; }
      else if (score >= 4) { color = '#22C55E'; text = 'Kuat'; width = '100%'; cls = 'text-green-600 font-semibold'; }

      strengthBar.style.width = width;
      strengthBar.style.backgroundColor = color;
      strengthText.textContent = text;
      strengthText.className = cls;
      isStrong = score >= 3 && checks.length;
    }

    function validate() {
      checkStrength();
      const matches = confirmIn.value && pwdIn.value === confirmIn.value;
      if (confirmIn.value) {
        confirmErr.classList.toggle('hidden', !!matches);
      } else {
        confirmErr.classList.add('hidden');
      }

      if (isStrong && matches) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('cursor-not-allowed', 'opacity-50');
        submitBtn.classList.add('cursor-pointer');
      } else {
        submitBtn.disabled = true;
        submitBtn.classList.add('cursor-not-allowed', 'opacity-50');
        submitBtn.classList.remove('cursor-pointer');
      }
    }

    pwdIn.addEventListener('input', validate);
    confirmIn.addEventListener('input', validate);

    function updateCrit(el, passed) {
      if (!el) return;
      const icon = el.querySelector('.status-icon');
      if (passed) { el.classList.replace('text-slate-400', 'text-green-600'); if (icon) icon.textContent = '✓'; }
      else { el.classList.replace('text-green-600', 'text-slate-400'); if (icon) icon.textContent = '▪'; }
    }
    function resetCrit(el) {
      if (!el) return;
      el.classList.remove('text-green-600');
      el.classList.add('text-slate-400');
      const icon = el.querySelector('.status-icon');
      if (icon) icon.textContent = '▪';
    }
  });
</script>

</body>
</html>
