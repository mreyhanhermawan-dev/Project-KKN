---
import AdminLayout from '../../components/AdminLayout.astro';
import { getPengaturan } from '../../lib/db/pengaturan';
import { getEnv } from '@lib/env';

const env = getEnv();
const s = env ? await getPengaturan(env.DB) : {};
const saved = Astro.url.searchParams.get('saved');

const stUmum = JSON.parse(s.stat_umum ?? '{}');
const dusun = JSON.parse(s.stat_dusun ?? '[]');
const umur = JSON.parse(s.stat_umur ?? '[]');
const pendidikan = JSON.parse(s.stat_pendidikan ?? '[]');
const pencaharian = JSON.parse(s.stat_pencaharian ?? '[]');

const inputCls = 'w-full rounded-lg border px-3 py-2 text-sm focus:outline-none';
const inputStyle = 'border-color:var(--color-border); min-height:40px;';
---

<AdminLayout title="Pengaturan" breadcrumb="Pengaturan">

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Pengaturan berhasil disimpan.
    </div>
  )}

  <div class="max-w-3xl space-y-8">

    <!-- Kontak & Media Sosial -->
    <div class="bg-white rounded-xl border border-border p-6" style="box-shadow:var(--shadow-sm);">
      <h2 class="font-heading font-bold text-xl mb-1" style="color:var(--color-primary);">Kontak & Media Sosial</h2>
      <p class="text-xs text-text-muted mb-4">Ditampilkan di footer semua halaman dan halaman Kontak. Kosongkan tautan sosial yang belum aktif.</p>
      <form method="POST" action="/api/admin/pengaturan" class="space-y-4">
        <input type="hidden" name="_form" value="kontak" />
        <div>
          <label for="kontak_alamat" class="block font-heading font-medium text-sm mb-1.5">Alamat Kantor</label>
          <input type="text" id="kontak_alamat" name="kontak_alamat" value={s.kontak_alamat ?? ''} class={inputCls} style={inputStyle} />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="kontak_telepon" class="block font-heading font-medium text-sm mb-1.5">Telepon</label>
            <input type="text" id="kontak_telepon" name="kontak_telepon" value={s.kontak_telepon ?? ''} class={inputCls} style={inputStyle} />
          </div>
          <div>
            <label for="kontak_email" class="block font-heading font-medium text-sm mb-1.5">Email</label>
            <input type="email" id="kontak_email" name="kontak_email" value={s.kontak_email ?? ''} class={inputCls} style={inputStyle} />
          </div>
        </div>
        <div>
          <label for="kontak_jam" class="block font-heading font-medium text-sm mb-1.5">Jam Layanan</label>
          <input type="text" id="kontak_jam" name="kontak_jam" value={s.kontak_jam ?? ''} class={inputCls} style={inputStyle} />
        </div>
        <fieldset class="border border-border rounded-lg p-4">
          <legend class="font-heading font-semibold text-sm px-2">Media Sosial (kosongkan bila belum aktif)</legend>
          <div class="space-y-3">
            {[
              ['sosial_whatsapp', 'URL WhatsApp', 'https://wa.me/62...'],
              ['sosial_facebook', 'URL Facebook', 'https://facebook.com/...'],
              ['sosial_instagram', 'URL Instagram', 'https://instagram.com/...'],
            ].map(([name, label, placeholder]) => (
              <div>
                <label for={name} class="block font-heading font-medium text-sm mb-1">{label}</label>
                <input type="url" id={name} name={name} value={s[name] ?? ''} placeholder={placeholder} class={inputCls} style={inputStyle} />
              </div>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer" style="background:var(--color-cta); min-height:44px;">
          Simpan Kontak
        </button>
      </form>
    </div>

    <!-- Statistik Kelurahan -->
    <div class="bg-white rounded-xl border border-border p-6" style="box-shadow:var(--shadow-sm);">
      <h2 class="font-heading font-bold text-xl mb-1" style="color:var(--color-primary);">Statistik Kelurahan</h2>
      <p class="text-xs text-text-muted mb-4">Tampil di halaman Profil, Pemerintahan, dan Beranda. Total penduduk/KK dihitung otomatis dari data per dusun.</p>
      <form method="POST" action="/api/admin/pengaturan" class="space-y-6">
        <input type="hidden" name="_form" value="statistik" />

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label for="luas" class="block font-heading font-medium text-sm mb-1.5">Luas Wilayah (ha)</label>
            <input type="text" id="luas" name="luas" value={stUmum.luas ?? ''} class={inputCls} style={inputStyle} />
          </div>
          <div>
            <label for="rw" class="block font-heading font-medium text-sm mb-1.5">Jumlah RW</label>
            <input type="number" id="rw" name="rw" value={stUmum.rw ?? ''} class={inputCls} style={inputStyle} />
          </div>
          <div>
            <label for="rt" class="block font-heading font-medium text-sm mb-1.5">Jumlah RT</label>
            <input type="number" id="rt" name="rt" value={stUmum.rt ?? ''} class={inputCls} style={inputStyle} />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Penduduk per Dusun</h3>
            <button type="button" id="btn-add-dusun" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Dusun</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-text-muted text-xs">
                  <th class="pb-1 pr-2">Nama Dusun</th>
                  <th class="pb-1 pr-2">RW</th>
                  <th class="pb-1 pr-2">Jml RW</th>
                  <th class="pb-1 pr-2">Laki-laki</th>
                  <th class="pb-1 pr-2">Perempuan</th>
                  <th class="pb-1 pr-2">KK</th>
                  <th class="pb-1 text-center w-10">Aksi</th>
                </tr>
              </thead>
              <tbody id="container-dusun">
                {dusun.map((d: any) => (
                  <tr class="item-row">
                    <td class="pr-2 py-1"><input type="text" name="dusun_label" value={d.label} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="text" name="dusun_rw" value={d.rw} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1 w-20"><input type="number" name="dusun_jmlRw" value={d.jmlRw} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="number" name="dusun_l" value={d.l} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="number" name="dusun_p" value={d.p} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="number" name="dusun_kk" value={d.kk} class={inputCls} style={inputStyle} required /></td>
                    <td class="py-1 text-center">
                      <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Golongan Umur</h3>
            <button type="button" id="btn-add-umur" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Kelompok Umur</button>
          </div>
          <div class="space-y-2" id="container-umur">
            {umur.map((u: any) => (
              <div class="grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row">
                <input type="text" name="umur_label" value={u.label} class={inputCls} style={inputStyle} required />
                <input type="number" name="umur_value" value={u.value} class={inputCls} style={inputStyle} required />
                <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
              </div>
            ))}
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Tingkat Pendidikan</h3>
            <button type="button" id="btn-add-pendidikan" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Pendidikan</button>
          </div>
          <div class="space-y-2" id="container-pendidikan">
            {pendidikan.map((p: any) => (
              <div class="grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row">
                <input type="text" name="pendidikan_label" value={p.label} class={inputCls} style={inputStyle} required />
                <input type="number" name="pendidikan_value" value={p.value} class={inputCls} style={inputStyle} required />
                <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
              </div>
            ))}
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Mata Pencaharian</h3>
            <button type="button" id="btn-add-pencaharian" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Pencaharian</button>
          </div>
          <div class="space-y-2" id="container-pencaharian">
            {pencaharian.map((p: any) => (
              <div class="grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row">
                <input type="text" name="pencaharian_label" value={p.label} class={inputCls} style={inputStyle} required />
                <input type="number" name="pencaharian_value" value={p.value} class={inputCls} style={inputStyle} required />
                <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
              </div>
            ))}
          </div>
        </div>

        <button type="submit" class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer" style="background:var(--color-cta); min-height:44px;">
          Simpan Statistik
        </button>
      </form>
    </div>

  </div>

</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const inputCls = 'w-full rounded-lg border px-3 py-2 text-sm focus:outline-none';
    const inputStyle = 'border-color:var(--color-border); min-height:40px;';

    // Helper untuk hapus baris
    document.addEventListener('click', (e) => {
      if (e.target && e.target.classList.contains('btn-delete')) {
        const row = e.target.closest('.item-row');
        if (row) {
          row.remove();
        }
      }
    });

    // Tambah Dusun
    const btnAddDusun = document.getElementById('btn-add-dusun');
    const containerDusun = document.getElementById('container-dusun');
    btnAddDusun?.addEventListener('click', () => {
      const tr = document.createElement('tr');
      tr.className = 'item-row';
      tr.innerHTML = `
        <td class="pr-2 py-1"><input type="text" name="dusun_label" class="${inputCls}" style="${inputStyle}" required /></td>
        <td class="pr-2 py-1"><input type="text" name="dusun_rw" class="${inputCls}" style="${inputStyle}" required /></td>
        <td class="pr-2 py-1 w-20"><input type="number" name="dusun_jmlRw" class="${inputCls}" style="${inputStyle}" required /></td>
        <td class="pr-2 py-1"><input type="number" name="dusun_l" class="${inputCls}" style="${inputStyle}" required /></td>
        <td class="pr-2 py-1"><input type="number" name="dusun_p" class="${inputCls}" style="${inputStyle}" required /></td>
        <td class="pr-2 py-1"><input type="number" name="dusun_kk" class="${inputCls}" style="${inputStyle}" required /></td>
        <td class="py-1 text-center">
          <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
        </td>
      `;
      containerDusun?.appendChild(tr);
    });

    // Tambah Umur
    const btnAddUmur = document.getElementById('btn-add-umur');
    const containerUmur = document.getElementById('container-umur');
    btnAddUmur?.addEventListener('click', () => {
      const div = document.createElement('div');
      div.className = 'grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row';
      div.innerHTML = `
        <input type="text" name="umur_label" class="${inputCls}" style="${inputStyle}" placeholder="Label kelompok" required />
        <input type="number" name="umur_value" class="${inputCls}" style="${inputStyle}" placeholder="Jumlah" required />
        <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
      `;
      containerUmur?.appendChild(div);
    });

    // Tambah Pendidikan
    const btnAddPendidikan = document.getElementById('btn-add-pendidikan');
    const containerPendidikan = document.getElementById('container-pendidikan');
    btnAddPendidikan?.addEventListener('click', () => {
      const div = document.createElement('div');
      div.className = 'grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row';
      div.innerHTML = `
        <input type="text" name="pendidikan_label" class="${inputCls}" style="${inputStyle}" placeholder="Label pendidikan" required />
        <input type="number" name="pendidikan_value" class="${inputCls}" style="${inputStyle}" placeholder="Jumlah" required />
        <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
      `;
      containerPendidikan?.appendChild(div);
    });

    // Tambah Pencaharian
    const btnAddPencaharian = document.getElementById('btn-add-pencaharian');
    const containerPencaharian = document.getElementById('container-pencaharian');
    btnAddPencaharian?.addEventListener('click', () => {
      const div = document.createElement('div');
      div.className = 'grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row';
      div.innerHTML = `
        <input type="text" name="pencaharian_label" class="${inputCls}" style="${inputStyle}" placeholder="Label pekerjaan" required />
        <input type="number" name="pencaharian_value" class="${inputCls}" style="${inputStyle}" placeholder="Jumlah" required />
        <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
      `;
      containerPencaharian?.appendChild(div);
    });
  });
</script>

