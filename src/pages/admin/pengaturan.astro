---
import AdminLayout from '../../components/AdminLayout.astro';
import { getPengaturan } from '../../lib/db/pengaturan';
import { getEnv } from '@lib/env';

const env = getEnv();
const s = env ? await getPengaturan(env.DB) : {};
const saved = Astro.url.searchParams.get('saved');
const pwdSaved = Astro.url.searchParams.get('pwd_saved');
const pwdErr = Astro.url.searchParams.get('pwd_err');
const adminSaved = Astro.url.searchParams.get('admin_saved');
const adminDeleted = Astro.url.searchParams.get('admin_deleted');
const adminErr = Astro.url.searchParams.get('admin_err');

const currentUsername = Astro.locals.user?.username;

const admins = env 
  ? await env.DB.prepare('SELECT id, username, email, created_at FROM admin_user ORDER BY id ASC').all<{ id: number; username: string; email: string | null; created_at: string }>().then(r => r.results || [])
  : [];

const stUmum = JSON.parse(s.stat_umum ?? '{}');
const dusun = JSON.parse(s.stat_dusun ?? '[]');
const umur = JSON.parse(s.stat_umur ?? '[]');
const pendidikan = JSON.parse(s.stat_pendidikan ?? '[]');
const pencaharian = JSON.parse(s.stat_pencaharian ?? '[]');

const inputCls = 'w-full rounded-lg border px-3 py-2 text-sm focus:outline-none';
const inputStyle = 'border-color:var(--color-border); min-height:40px;';
---

<AdminLayout title="Pengaturan" breadcrumb="Pengaturan">

  {saved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Pengaturan berhasil disimpan.
    </div>
  )}

  {pwdSaved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Kata sandi berhasil diperbarui.
    </div>
  )}

  {pwdErr && (
    <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FECACA;">
      {pwdErr === 'wrong_current' && 'Kata sandi saat ini salah.'}
      {pwdErr === 'weak' && 'Kata sandi baru terlalu lemah (minimal 8 karakter dengan 3 kriteria kekuatan).'}
      {pwdErr === 'mismatch' && 'Konfirmasi kata sandi baru tidak cocok.'}
      {pwdErr === '1' && 'Gagal memperbarui kata sandi.'}
    </div>
  )}

  {adminSaved && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Admin baru berhasil ditambahkan.
    </div>
  )}

  {adminDeleted && (
    <div role="status" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;">
      Admin berhasil dihapus.
    </div>
  )}

  {adminErr && (
    <div role="alert" class="mb-4 p-3 rounded-lg text-sm font-medium" style="background:#FEE2E2; color:#991B1B; border:1px solid #FECACA;">
      {adminErr === 'limit' && 'Batas maksimal 3 akun admin telah tercapai.'}
      {adminErr === 'exists' && 'Nama pengguna sudah terdaftar.'}
      {adminErr === 'username' && 'Format nama pengguna tidak valid. Gunakan 3-20 karakter berupa huruf, angka, strip, atau garis bawah.'}
      {adminErr === 'weak' && 'Kata sandi terlalu lemah (minimal 8 karakter dengan 3 kriteria kekuatan).'}
      {adminErr === 'delete_last' && 'Tidak dapat menghapus admin terakhir.'}
      {adminErr === 'delete_self' && 'Anda tidak dapat menghapus akun Anda sendiri yang sedang aktif.'}
      {adminErr === '1' && 'Gagal memproses permintaan.'}
    </div>
  )}

  <div class="max-w-3xl space-y-8">

    <!-- Kontak & Media Sosial -->
    <div class="bg-white rounded-xl border border-border p-6" style="box-shadow:var(--shadow-sm);">
      <h2 class="font-heading font-bold text-xl mb-1" style="color:var(--color-primary);">Kontak & Media Sosial</h2>
      <p class="text-xs text-text-muted mb-4">Ditampilkan di footer semua halaman dan halaman Kontak. Kosongkan tautan sosial yang belum aktif.</p>
      <form method="POST" action="/api/admin/pengaturan" class="space-y-4">
        <input type="hidden" name="_form" value="kontak" />
        <div>
          <label for="kontak_alamat" class="block font-heading font-medium text-sm mb-1.5">Alamat Kantor</label>
          <input type="text" id="kontak_alamat" name="kontak_alamat" value={s.kontak_alamat ?? ''} class={inputCls} style={inputStyle} />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="kontak_telepon" class="block font-heading font-medium text-sm mb-1.5">Telepon</label>
            <input type="text" id="kontak_telepon" name="kontak_telepon" value={s.kontak_telepon ?? ''} class={inputCls} style={inputStyle} />
          </div>
          <div>
            <label for="kontak_email" class="block font-heading font-medium text-sm mb-1.5">Email</label>
            <input type="email" id="kontak_email" name="kontak_email" value={s.kontak_email ?? ''} class={inputCls} style={inputStyle} />
          </div>
        </div>
        <div>
          <label for="kontak_jam" class="block font-heading font-medium text-sm mb-1.5">Jam Layanan</label>
          <input type="text" id="kontak_jam" name="kontak_jam" value={s.kontak_jam ?? ''} class={inputCls} style={inputStyle} />
        </div>
        <fieldset class="border border-border rounded-lg p-4">
          <legend class="font-heading font-semibold text-sm px-2">Media Sosial (kosongkan bila belum aktif)</legend>
          <div class="space-y-3">
            {[
              ['sosial_whatsapp', 'URL WhatsApp', 'https://wa.me/62...'],
              ['sosial_facebook', 'URL Facebook', 'https://facebook.com/...'],
              ['sosial_instagram', 'URL Instagram', 'https://instagram.com/...'],
            ].map(([name, label, placeholder]) => (
              <div>
                <label for={name} class="block font-heading font-medium text-sm mb-1">{label}</label>
                <input type="url" id={name} name={name} value={s[name] ?? ''} placeholder={placeholder} class={inputCls} style={inputStyle} />
              </div>
            ))}
          </div>
        </fieldset>

        <div>
          <label class="block font-heading font-medium text-sm mb-1.5">Logo Kelurahan (Menggantikan bulat "KP")</label>
          <div class="flex items-center gap-4">
            <div id="logo_preview_container" class="w-12 h-12 rounded-full border border-slate-200 flex items-center justify-center bg-slate-50 overflow-hidden shadow-sm">
              {s.situs_logo ? (
                <img id="logo_preview" src={s.situs_logo.startsWith('/') ? s.situs_logo : `/api/media/${encodeURIComponent(s.situs_logo)}`} alt="Logo Kelurahan" class="w-full h-full object-cover" />
              ) : (
                <span id="logo_placeholder" class="font-heading font-bold text-sm text-primary">KP</span>
              )}
            </div>
            <div class="flex flex-col gap-1">
              <label class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg font-heading font-semibold text-xs border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition-colors" style="min-height:36px;">
                Unggah Logo
                <input type="file" id="logo_file" accept="image/*" class="hidden" />
              </label>
              <p id="logo_upload_status" class="text-[11px] text-text-muted"></p>
              <input type="hidden" name="situs_logo" id="situs_logo_input" value={s.situs_logo ?? ''} />
            </div>
          </div>
        </div>

        <button type="submit" class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer" style="background:var(--color-cta); min-height:44px;">
          Simpan Kontak
        </button>
      </form>
    </div>

    <!-- Statistik Kelurahan -->
    <div class="bg-white rounded-xl border border-border p-6" style="box-shadow:var(--shadow-sm);">
      <h2 class="font-heading font-bold text-xl mb-1" style="color:var(--color-primary);">Statistik Kelurahan</h2>
      <p class="text-xs text-text-muted mb-4">Tampil di halaman Profil, Pemerintahan, dan Beranda. Total penduduk/KK dihitung otomatis dari data per dusun.</p>
      <form method="POST" action="/api/admin/pengaturan" class="space-y-6">
        <input type="hidden" name="_form" value="statistik" />

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label for="luas" class="block font-heading font-medium text-sm mb-1.5">Luas Wilayah (ha)</label>
            <input type="text" id="luas" name="luas" value={stUmum.luas ?? ''} class={inputCls} style={inputStyle} />
          </div>
          <div>
            <label for="rw" class="block font-heading font-medium text-sm mb-1.5">Jumlah RW</label>
            <input type="number" id="rw" name="rw" value={stUmum.rw ?? ''} class={inputCls} style={inputStyle} />
          </div>
          <div>
            <label for="rt" class="block font-heading font-medium text-sm mb-1.5">Jumlah RT</label>
            <input type="number" id="rt" name="rt" value={stUmum.rt ?? ''} class={inputCls} style={inputStyle} />
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Penduduk per Dusun</h3>
            <button type="button" id="btn-add-dusun" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Dusun</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-text-muted text-xs">
                  <th class="pb-1 pr-2">Nama Dusun</th>
                  <th class="pb-1 pr-2">RW</th>
                  <th class="pb-1 pr-2">Jml RW</th>
                  <th class="pb-1 pr-2">Laki-laki</th>
                  <th class="pb-1 pr-2">Perempuan</th>
                  <th class="pb-1 pr-2">KK</th>
                  <th class="pb-1 text-center w-10">Aksi</th>
                </tr>
              </thead>
              <tbody id="container-dusun">
                {dusun.map((d: any) => (
                  <tr class="item-row">
                    <td class="pr-2 py-1"><input type="text" name="dusun_label" value={d.label} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="text" name="dusun_rw" value={d.rw} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1 w-20"><input type="number" name="dusun_jmlRw" value={d.jmlRw} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="number" name="dusun_l" value={d.l} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="number" name="dusun_p" value={d.p} class={inputCls} style={inputStyle} required /></td>
                    <td class="pr-2 py-1"><input type="number" name="dusun_kk" value={d.kk} class={inputCls} style={inputStyle} required /></td>
                    <td class="py-1 text-center">
                      <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Golongan Umur</h3>
            <button type="button" id="btn-add-umur" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Kelompok Umur</button>
          </div>
          <div class="space-y-2" id="container-umur">
            {umur.map((u: any) => (
              <div class="grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row">
                <input type="text" name="umur_label" value={u.label} class={inputCls} style={inputStyle} required />
                <input type="number" name="umur_value" value={u.value} class={inputCls} style={inputStyle} required />
                <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
              </div>
            ))}
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Tingkat Pendidikan</h3>
            <button type="button" id="btn-add-pendidikan" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Pendidikan</button>
          </div>
          <div class="space-y-2" id="container-pendidikan">
            {pendidikan.map((p: any) => (
              <div class="grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row">
                <input type="text" name="pendidikan_label" value={p.label} class={inputCls} style={inputStyle} required />
                <input type="number" name="pendidikan_value" value={p.value} class={inputCls} style={inputStyle} required />
                <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
              </div>
            ))}
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="font-heading font-semibold text-sm">Mata Pencaharian</h3>
            <button type="button" id="btn-add-pencaharian" class="text-xs font-heading font-semibold text-accent hover:underline cursor-pointer">+ Tambah Pencaharian</button>
          </div>
          <div class="space-y-2" id="container-pencaharian">
            {pencaharian.map((p: any) => (
              <div class="grid grid-cols-[1fr_1fr_60px] gap-2 items-center item-row">
                <input type="text" name="pencaharian_label" value={p.label} class={inputCls} style={inputStyle} required />
                <input type="number" name="pencaharian_value" value={p.value} class={inputCls} style={inputStyle} required />
                <button type="button" class="btn-delete text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer">Hapus</button>
              </div>
            ))}
          </div>
        </div>

        <button type="submit" class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-pointer" style="background:var(--color-cta); min-height:44px;">
          Simpan Statistik
        </button>
      </form>
    </div>

    <!-- Ubah Kata Sandi -->
    <div class="bg-white rounded-xl border border-border p-6" style="box-shadow:var(--shadow-sm);">
      <h2 class="font-heading font-bold text-xl mb-1" style="color:var(--color-primary);">Ubah Kata Sandi</h2>
      <p class="text-xs text-text-muted mb-4">Ganti kata sandi akun admin Anda. Disarankan menggunakan kombinasi kata sandi yang kuat.</p>
      
      <form method="POST" action="/api/admin/pengaturan" class="space-y-4">
        <input type="hidden" name="_form" value="password" />
        
        <div>
          <label for="current_password" class="block font-heading font-medium text-sm mb-1.5">Kata Sandi Saat Ini</label>
          <input type="password" id="current_password" name="current_password" required class={inputCls} style={inputStyle} />
        </div>
        
        <div>
          <label for="new_password" class="block font-heading font-medium text-sm mb-1.5">Kata Sandi Baru</label>
          <input type="password" id="new_password" name="new_password" required minlength="8" class={inputCls} style={inputStyle} />
          
          <!-- Password Strength Meter -->
          <div class="mt-2.5 space-y-2">
            <div class="flex justify-between items-center text-xs">
              <span class="text-text-muted">Kekuatan Kata Sandi:</span>
              <span id="pwd-strength-text" class="font-semibold text-slate-400">Belum diisi</span>
            </div>
            <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
              <div id="pwd-strength-bar" class="h-full w-0 transition-all duration-300 ease-out bg-slate-400"></div>
            </div>
            
            <!-- Criteria Checklist -->
            <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] pt-1 border-t border-slate-100 mt-2">
              <div id="pwd-crit-length" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                <span class="status-icon font-bold">▪</span> Minimal 8 karakter
              </div>
              <div id="pwd-crit-upper" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                <span class="status-icon font-bold">▪</span> Huruf Besar (A-Z)
              </div>
              <div id="pwd-crit-lower" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                <span class="status-icon font-bold">▪</span> Huruf Kecil (a-z)
              </div>
              <div id="pwd-crit-number" class="flex items-center gap-1.5 text-slate-400 transition-colors">
                <span class="status-icon font-bold">▪</span> Angka (0-9)
              </div>
              <div id="pwd-crit-special" class="flex items-center gap-1.5 text-slate-400 transition-colors col-span-2">
                <span class="status-icon font-bold">▪</span> Karakter Khusus (@$!%*?&#)
              </div>
            </div>
          </div>
        </div>
        
        <div>
          <label for="confirm_new_password" class="block font-heading font-medium text-sm mb-1.5">Konfirmasi Kata Sandi Baru</label>
          <input type="password" id="confirm_new_password" name="confirm_new_password" required minlength="8" class={inputCls} style={inputStyle} />
          <p id="pwd-confirm-error" class="text-xs text-red-500 mt-1 hidden">Kata sandi tidak cocok.</p>
        </div>
        
        <button type="submit" id="submit-pwd-btn" disabled class="px-5 py-2 rounded-lg font-heading font-semibold text-white text-sm cursor-not-allowed opacity-50 transition-all duration-200" style="background:var(--color-cta); min-height:44px;">
          Perbarui Kata Sandi
        </button>
      </form>
    </div>

    <!-- Manajemen Akun Admin -->
    <div class="bg-white rounded-xl border border-border p-6" style="box-shadow:var(--shadow-sm);">
      <h2 class="font-heading font-bold text-xl mb-1" style="color:var(--color-primary);">Manajemen Akun Admin</h2>
      <p class="text-xs text-text-muted mb-4">Kelola akun admin yang terdaftar. Maksimal 3 admin dapat didaftarkan.</p>

      <!-- List of admins -->
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-text-muted text-xs border-b border-slate-100">
              <th class="pb-2">Nama Pengguna</th>
              <th class="pb-2">Email</th>
              <th class="pb-2">Dibuat Pada</th>
              <th class="pb-2 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {admins.map((adm) => (
              <tr>
                <td class="py-2.5 font-medium">{adm.username} {adm.username === currentUsername && <span class="text-[10px] bg-slate-100 px-1.5 py-0.5 rounded text-text-muted ml-1">Aktif</span>}</td>
                <td class="py-2.5 text-text-muted text-xs">{adm.email ?? <span class="italic text-slate-300">-</span>}</td>
                <td class="py-2.5 text-text-muted text-xs">{adm.created_at}</td>
                <td class="py-2.5 text-right">
                  {admins.length > 1 && adm.username !== currentUsername ? (
                    <form method="POST" action="/api/admin/pengaturan" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus admin ini?')">
                      <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken} />
                      <input type="hidden" name="_form" value="delete_admin" />
                      <input type="hidden" name="admin_id" value={adm.id} />
                      <button type="submit" class="text-xs font-semibold text-red-500 hover:text-red-700 cursor-pointer">Hapus</button>
                    </form>
                  ) : (
                    <span class="text-xs text-slate-300">-</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Add admin form (only shown if admins count < 3) -->
      {admins.length < 3 ? (
        <fieldset class="border border-border rounded-lg p-4 bg-slate-50/50">
          <legend class="font-heading font-semibold text-sm px-2 text-primary">Tambah Admin Baru</legend>
          <form method="POST" action="/api/admin/pengaturan" class="space-y-4">
            <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken} />
            <input type="hidden" name="_form" value="add_admin" />
            
            <div>
              <label for="new_admin_username" class="block font-heading font-medium text-xs mb-1">Nama Pengguna baru</label>
              <input type="text" id="new_admin_username" name="username" required
                pattern="[a-zA-Z0-9_-]{3,20}"
                title="3-20 karakter berupa huruf, angka, garis bawah (_), atau strip (-)"
                class={inputCls} style={inputStyle} />
              <p id="new-admin-user-error" class="text-[10px] text-red-500 mt-0.5 hidden">Format nama pengguna tidak valid.</p>
            </div>

            <div>
              <label for="new_admin_email" class="block font-heading font-medium text-xs mb-1">Alamat Email</label>
              <input type="email" id="new_admin_email" name="email" required
                placeholder="contoh@email.com"
                autocomplete="off"
                class={inputCls} style={inputStyle} />
              <p id="new-admin-email-error" class="text-[10px] text-red-500 mt-0.5 hidden">Format email tidak valid.</p>
            </div>

            <div>
              <label for="new_admin_password" class="block font-heading font-medium text-xs mb-1">Kata Sandi</label>
              <input type="password" id="new_admin_password" name="password" required minlength="8" class={inputCls} style={inputStyle} />
              
              <!-- Password Strength Meter -->
              <div class="mt-2 space-y-1.5">
                <div class="flex justify-between items-center text-[10px]">
                  <span class="text-text-muted">Kekuatan Kata Sandi:</span>
                  <span id="new-admin-strength-text" class="font-semibold text-slate-400">Belum diisi</span>
                </div>
                <div class="w-full h-1 bg-slate-100 rounded-full overflow-hidden">
                  <div id="new-admin-strength-bar" class="h-full w-0 transition-all duration-300 ease-out bg-slate-400"></div>
                </div>
                
                <!-- Criteria Checklist -->
                <div class="grid grid-cols-2 gap-x-2 gap-y-0.5 text-[10px] pt-1 border-t border-slate-100">
                  <div id="new-admin-crit-length" class="flex items-center gap-1 text-slate-400">
                    <span class="status-icon font-bold">▪</span> Min 8 karakter
                  </div>
                  <div id="new-admin-crit-upper" class="flex items-center gap-1 text-slate-400">
                    <span class="status-icon font-bold">▪</span> Huruf Besar
                  </div>
                  <div id="new-admin-crit-lower" class="flex items-center gap-1 text-slate-400">
                    <span class="status-icon font-bold">▪</span> Huruf Kecil
                  </div>
                  <div id="new-admin-crit-number" class="flex items-center gap-1 text-slate-400">
                    <span class="status-icon font-bold">▪</span> Angka
                  </div>
                  <div id="new-admin-crit-special" class="flex items-center gap-1 text-slate-400 col-span-2">
                    <span class="status-icon font-bold">▪</span> Karakter Khusus (@$!%*)
                  </div>
                </div>
              </div>
            </div>

            <div>
              <label for="new_admin_confirm_password" class="block font-heading font-medium text-xs mb-1">Konfirmasi Kata Sandi</label>
              <input type="password" id="new_admin_confirm_password" name="confirm_password" required minlength="8" class={inputCls} style={inputStyle} />
              <p id="new-admin-confirm-error" class="text-[10px] text-red-500 mt-0.5 hidden">Kata sandi tidak cocok.</p>
            </div>

            <button type="submit" id="submit-new-admin-btn" disabled class="px-4 py-2 rounded-lg font-heading font-semibold text-white text-xs cursor-not-allowed opacity-50 transition-all duration-200" style="background:var(--color-cta); min-height:36px;">
              Tambah Admin
            </button>
          </form>
        </fieldset>
      ) : (
        <div class="p-3 rounded-lg text-xs font-medium text-center" style="background:#EFF6FF; color:#1E40AF; border:1px solid #BFDBFE;">
          Batas maksimal 3 akun admin telah tercapai. Hapus salah satu admin jika ingin menambah baru.
        </div>
      )}
    </div>

  </div>

</AdminLayout>

