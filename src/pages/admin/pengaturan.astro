<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const newPwd = document.getElementById('new_password');
    const confirmNewPwd = document.getElementById('confirm_new_password');
    const confirmErr = document.getElementById('pwd-confirm-error');
    const strengthBar = document.getElementById('pwd-strength-bar');
    const strengthText = document.getElementById('pwd-strength-text');
    const submitBtn = document.getElementById('submit-pwd-btn');

    // Criteria elements
    const critLength = document.getElementById('pwd-crit-length');
    const critUpper = document.getElementById('pwd-crit-upper');
    const critLower = document.getElementById('pwd-crit-lower');
    const critNumber = document.getElementById('pwd-crit-number');
    const critSpecial = document.getElementById('pwd-crit-special');

    if (!newPwd || !confirmNewPwd) return;

    let isStrong = false;

    function checkPwdStrength() {
      const val = newPwd.value;
      if (!val) {
        strengthBar.style.width = '0%';
        strengthBar.style.backgroundColor = '#CBD5E1';
        strengthText.textContent = 'Belum diisi';
        strengthText.className = 'font-semibold text-slate-400';
        isStrong = false;
        
        resetPwdCrit(critLength);
        resetPwdCrit(critUpper);
        resetPwdCrit(critLower);
        resetPwdCrit(critNumber);
        resetPwdCrit(critSpecial);
        return;
      }

      const checks = {
        length: val.length >= 8,
        upper: /[A-Z]/.test(val),
        lower: /[a-z]/.test(val),
        number: /\d/.test(val),
        special: /[@$!%*?&#_.\-+=~`'":;?,<>|\(\)\[\]\{\}\\\/^\*]/.test(val)
      };

      updatePwdCrit(critLength, checks.length);
      updatePwdCrit(critUpper, checks.upper);
      updatePwdCrit(critLower, checks.lower);
      updatePwdCrit(critNumber, checks.number);
      updatePwdCrit(critSpecial, checks.special);

      const score = Object.values(checks).filter(Boolean).length;

      let color = '#EF4444'; // Red
      let text = 'Sangat Lemah';
      let width = '20%';
      let textColorCls = 'text-red-500 font-semibold';

      if (score === 2) {
        color = '#F97316'; // Orange
        text = 'Lemah';
        width = '40%';
        textColorCls = 'text-orange-500 font-semibold';
      } else if (score === 3) {
        color = '#EAB308'; // Yellow
        text = 'Sedang';
        width = '65%';
        textColorCls = 'text-yellow-600 font-semibold';
      } else if (score >= 4) {
        color = '#22C55E'; // Green
        text = 'Kuat';
        width = '100%';
        textColorCls = 'text-green-600 font-semibold';
      }

      strengthBar.style.width = width;
      strengthBar.style.backgroundColor = color;
      strengthText.textContent = text;
      strengthText.className = textColorCls;

      isStrong = score >= 3 && checks.length;
    }

    function validatePwdForm() {
      checkPwdStrength();
      
      const pwdVal = newPwd.value;
      const confirmVal = confirmNewPwd.value;
      
      let matches = false;
      
      if (confirmVal) {
        if (pwdVal !== confirmVal) {
          confirmErr.classList.remove('hidden');
          matches = false;
        } else {
          confirmErr.classList.add('hidden');
          matches = true;
        }
      } else {
        confirmErr.classList.add('hidden');
        matches = false;
      }

      if (isStrong && matches) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('cursor-not-allowed', 'opacity-50');
        submitBtn.classList.add('cursor-pointer');
      } else {
        submitBtn.disabled = true;
        submitBtn.classList.add('cursor-not-allowed', 'opacity-50');
        submitBtn.classList.remove('cursor-pointer');
      }
    }

    newPwd.addEventListener('input', validatePwdForm);
    confirmNewPwd.addEventListener('input', validatePwdForm);

    function updatePwdCrit(el, passed) {
      if (!el) return;
      const icon = el.querySelector('.status-icon');
      if (passed) {
        el.classList.remove('text-slate-400');
        el.classList.add('text-green-600');
        if (icon) icon.textContent = '✓';
      } else {
        el.classList.remove('text-green-600');
        el.classList.add('text-slate-400');
        if (icon) icon.textContent = '▪';
      }
    }

    function resetPwdCrit(el) {
      if (!el) return;
      const icon = el.querySelector('.status-icon');
      el.classList.remove('text-green-600');
      el.classList.add('text-slate-400');
      if (icon) icon.textContent = '▪';
    }
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const userIn = document.getElementById('new_admin_username');
    const userErr = document.getElementById('new-admin-user-error');
    const pwdIn = document.getElementById('new_admin_password');
    const confirmIn = document.getElementById('new_admin_confirm_password');
    const confirmErr = document.getElementById('new-admin-confirm-error');
    const strengthBar = document.getElementById('new-admin-strength-bar');
    const strengthText = document.getElementById('new-admin-strength-text');
    const submitBtn = document.getElementById('submit-new-admin-btn');

    // Criteria elements
    const critLength = document.getElementById('new-admin-crit-length');
    const critUpper = document.getElementById('new-admin-crit-upper');
    const critLower = document.getElementById('new-admin-crit-lower');
    const critNumber = document.getElementById('new-admin-crit-number');
    const critSpecial = document.getElementById('new-admin-crit-special');

    if (!userIn || !pwdIn || !confirmIn || !submitBtn) return;

    const emailIn = document.getElementById('new_admin_email');
    const emailErr = document.getElementById('new-admin-email-error');

    let isUsernameValid = false;
    let isEmailValid = false;
    let isStrong = false;

    function checkNewAdminStrength() {
      const val = pwdIn.value;
      if (!val) {
        strengthBar.style.width = '0%';
        strengthBar.style.backgroundColor = '#CBD5E1';
        strengthText.textContent = 'Belum diisi';
        strengthText.className = 'font-semibold text-slate-400';
        isStrong = false;
        
        resetNewCrit(critLength);
        resetNewCrit(critUpper);
        resetNewCrit(critLower);
        resetNewCrit(critNumber);
        resetNewCrit(critSpecial);
        return;
      }

      const checks = {
        length: val.length >= 8,
        upper: /[A-Z]/.test(val),
        lower: /[a-z]/.test(val),
        number: /\d/.test(val),
        special: /[@$!%*?&#_.\-+=~`'":;?,<>|\(\)\[\]\{\}\\\/^\*]/.test(val)
      };

      updateNewCrit(critLength, checks.length);
      updateNewCrit(critUpper, checks.upper);
      updateNewCrit(critLower, checks.lower);
      updateNewCrit(critNumber, checks.number);
      updateNewCrit(critSpecial, checks.special);

      const score = Object.values(checks).filter(Boolean).length;

      let color = '#EF4444'; // Red
      let text = 'Sangat Lemah';
      let width = '20%';
      let textColorCls = 'text-red-500 font-semibold';

      if (score === 2) {
        color = '#F97316'; // Orange
        text = 'Lemah';
        width = '40%';
        textColorCls = 'text-orange-500 font-semibold';
      } else if (score === 3) {
        color = '#EAB308'; // Yellow
        text = 'Sedang';
        width = '65%';
        textColorCls = 'text-yellow-600 font-semibold';
      } else if (score >= 4) {
        color = '#22C55E'; // Green
        text = 'Kuat';
        width = '100%';
        textColorCls = 'text-green-600 font-semibold';
      }

      strengthBar.style.width = width;
      strengthBar.style.backgroundColor = color;
      strengthText.textContent = text;
      strengthText.className = textColorCls;

      isStrong = score >= 3 && checks.length;
    }

    function validateNewAdminForm() {
      // 1. Check Username
      const usernameVal = userIn.value;
      const usernameRegex = /^[a-zA-Z0-9_-]{3,20}$/;
      
      if (usernameVal) {
        if (!usernameRegex.test(usernameVal)) {
          userErr.classList.remove('hidden');
          isUsernameValid = false;
        } else {
          userErr.classList.add('hidden');
          isUsernameValid = true;
        }
      } else {
        userErr.classList.add('hidden');
        isUsernameValid = false;
      }

      // 2. Check email
      if (emailIn) {
        const emailVal = emailIn.value;
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (emailVal) {
          if (!emailRegex.test(emailVal)) {
            emailErr && emailErr.classList.remove('hidden');
            isEmailValid = false;
          } else {
            emailErr && emailErr.classList.add('hidden');
            isEmailValid = true;
          }
        } else {
          emailErr && emailErr.classList.add('hidden');
          isEmailValid = false;
        }
      }

      // 3. Check password strength
      checkNewAdminStrength();

      // 3. Check password confirmation matches
      const pwdVal = pwdIn.value;
      const confirmVal = confirmIn.value;
      
      let matches = false;
      
      if (confirmVal) {
        if (pwdVal !== confirmVal) {
          confirmErr.classList.remove('hidden');
          matches = false;
        } else {
          confirmErr.classList.add('hidden');
          matches = true;
        }
      } else {
        confirmErr.classList.add('hidden');
        matches = false;
      }

      // Enable/Disable
      if (isUsernameValid && isEmailValid && isStrong && matches) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('cursor-not-allowed', 'opacity-50');
        submitBtn.classList.add('cursor-pointer');
      } else {
        submitBtn.disabled = true;
        submitBtn.classList.add('cursor-not-allowed', 'opacity-50');
        submitBtn.classList.remove('cursor-pointer');
      }
    }

    userIn.addEventListener('input', validateNewAdminForm);
    emailIn && emailIn.addEventListener('input', validateNewAdminForm);
    pwdIn.addEventListener('input', validateNewAdminForm);
    confirmIn.addEventListener('input', validateNewAdminForm);

    function updateNewCrit(el, passed) {
      if (!el) return;
      const icon = el.querySelector('.status-icon');
      if (passed) {
        el.classList.remove('text-slate-400');
        el.classList.add('text-green-600');
        if (icon) icon.textContent = '✓';
      } else {
        el.classList.remove('text-green-600');
        el.classList.add('text-slate-400');
        if (icon) icon.textContent = '▪';
      }
    }

    function resetNewCrit(el) {
      if (!el) return;
      const icon = el.querySelector('.status-icon');
      el.classList.remove('text-green-600');
      el.classList.add('text-slate-400');
      if (icon) icon.textContent = '▪';
    }
  });
</script>

<script>
  const logoFile = document.getElementById('logo_file') as HTMLInputElement;
  const logoPreviewContainer = document.getElementById('logo_preview_container') as HTMLDivElement;
  const logoUploadStatus = document.getElementById('logo_upload_status') as HTMLParagraphElement;
  const logoInputHidden = document.getElementById('situs_logo_input') as HTMLInputElement;

  if (logoFile) {
    logoFile.addEventListener('change', async () => {
      const file = logoFile.files?.[0];
      if (!file) return;

      if (logoUploadStatus) logoUploadStatus.textContent = 'Mengunggah logo...';
      try {
        const { uploadImage } = await import('../../scripts/admin-editor');
        const res = await uploadImage(file, 'Logo Kelurahan', {
          purge: '/'
        });
        
        const key = res.url.replace('/api/media/', '');
        if (logoInputHidden) logoInputHidden.value = key;
        
        // Update preview
        if (logoPreviewContainer) {
          logoPreviewContainer.innerHTML = `<img id="logo_preview" src="${res.url}" alt="Logo Kelurahan" class="w-full h-full object-cover" />`;
        }
        if (logoUploadStatus) logoUploadStatus.textContent = 'Logo berhasil diunggah.';
      } catch (err) {
        console.error(err);
        if (logoUploadStatus) logoUploadStatus.textContent = 'Upload gagal.';
      }
    });
  }
</script>

