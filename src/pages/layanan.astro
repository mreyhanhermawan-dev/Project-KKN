---
import Layout from "../components/Layout.astro";
import { getPengaturan } from "../lib/db/pengaturan";
import { getLayananData } from "../lib/db/layanan";
import { getEnv } from "@lib/env";

const env = getEnv();
const s = env ? await getPengaturan(env.DB) : {};

const fallbackLayananCategories = [
    {
        id: "kependudukan",
        title: "Kependudukan & Catatan Sipil",
        description:
            "Pengurusan kartu identitas, kartu keluarga, dan surat keterangan kependudukan lainnya.",
        icon: "user-check",
        items: [
            {
                nama: "Surat Pengantar KTP / Kartu Keluarga",
                deskripsi:
                    "Surat pengantar untuk menerbitkan atau melakukan perubahan data pada Kartu Tanda Penduduk (KTP) dan Kartu Keluarga (KK) di Dinas Kependudukan dan Catatan Sipil.",
                syarat: [
                    "Surat pengantar dari RT/RW setempat",
                    "Fotokopi KTP / KK lama (jika ada perubahan/hilang)",
                    "Fotokopi Akta Kelahiran / Akta Nikah / Ijazah",
                    "Surat Kehilangan dari Kepolisian (jika KTP/KK lama hilang)",
                ],
                estimasi: "1 Hari Kerja",
                biaya: "Gratis",
            },
            {
                nama: "Surat Keterangan Domisili",
                deskripsi:
                    "Surat keterangan resmi yang menyatakan tempat tinggal atau keberadaan seseorang di wilayah Kelurahan Palabuhanratu.",
                syarat: [
                    "Surat pengantar RT/RW setempat",
                    "Fotokopi KTP dan Kartu Keluarga pemohon",
                    "Surat kuasa bermaterai (jika diwakilkan)",
                ],
                estimasi: "1 Hari Kerja",
                biaya: "Gratis",
            },
            {
                nama: "Surat Keterangan Pindah / Datang",
                deskripsi:
                    "Surat keterangan untuk warga yang ingin pindah keluar daerah atau melapor kedatangan dari luar wilayah Kelurahan Palabuhanratu.",
                syarat: [
                    "Surat pengantar RT/RW setempat",
                    "Kartu Keluarga asli dan KTP asli",
                    "Surat Keterangan Pindah dari daerah asal (bagi warga baru yang datang)",
                    "Pas foto terbaru ukuran 3x4 (2 lembar)",
                ],
                estimasi: "1 - 2 Hari Kerja",
                biaya: "Gratis",
            },
        ],
    },
    {
        id: "sosial",
        title: "Kesejahteraan Sosial & Kesehatan",
        description:
            "Layanan rekomendasi sosial, bantuan pemerintah, dan fasilitas kesehatan masyarakat.",
        icon: "heart-handshake",
        items: [
            {
                nama: "Surat Keterangan Tidak Mampu (SKTM)",
                deskripsi:
                    "Surat keterangan untuk memperoleh keringanan biaya pendidikan, pengobatan/kesehatan, atau keperluan sosial lainnya bagi keluarga prasejahtera.",
                syarat: [
                    "Surat pengantar RT/RW setempat yang menyatakan tidak mampu",
                    "Fotokopi Kartu Keluarga dan KTP pemohon",
                    "Fotokopi Kartu Indonesia Sehat (KIS)/BPJS (jika ada)",
                    "Surat pernyataan tidak mampu bermaterai Rp 10.000 diketahui RT/RW",
                ],
                estimasi: "1 Hari Kerja",
                biaya: "Gratis",
            },
            {
                nama: "Rekomendasi Bantuan Sosial",
                deskripsi:
                    "Pengajuan atau usulan untuk terdaftar sebagai penerima program bantuan sosial pemerintah (PKH, BPNT, PBI APBD, dll).",
                syarat: [
                    "Fotokopi Kartu Keluarga dan KTP",
                    "Surat keterangan tidak mampu (SKTM) dari kelurahan",
                    "Mengisi formulir DTKS (Data Terpadu Kesejahteraan Sosial)",
                ],
                estimasi: "Sesuai jadwal verifikasi dinas terkait",
                biaya: "Gratis",
            },
        ],
    },
    {
        id: "usaha-tanah",
        title: "Usaha & Pertanahan",
        description:
            "Surat keterangan usaha mikro, legalitas pengantar, dan administrasi pertanahan kelurahan.",
        icon: "briefcase",
        items: [
            {
                nama: "Surat Keterangan Usaha (SKU)",
                deskripsi:
                    "Surat keterangan resmi yang menyatakan bahwa pemohon benar memiliki suatu usaha mikro, kecil, atau menengah (UMKM) di wilayah Kelurahan Palabuhanratu.",
                syarat: [
                    "Surat pengantar RT/RW setempat",
                    "Fotokopi KTP dan Kartu Keluarga pemilik usaha",
                    "Foto tempat usaha / aktivitas usaha",
                    "Mengisi surat pernyataan kepemilikan usaha",
                ],
                estimasi: "1 Hari Kerja",
                biaya: "Gratis",
            },
            {
                nama: "Surat Pengantar Nikah (N1, N2, N4)",
                deskripsi:
                    "Surat pengantar kelurahan sebagai syarat wajib pernikahan untuk didaftarkan ke KUA (Kantor Urusan Agama) atau Pencatatan Sipil.",
                syarat: [
                    "Surat pengantar RT/RW setempat",
                    "Fotokopi KTP dan Kartu Keluarga calon pengantin",
                    "Fotokopi Akta Kelahiran dan Ijazah calon pengantin",
                    "Fotokopi KTP orang tua / wali",
                    "Surat Kematian/Cerai asli (jika berstatus janda/duda)",
                    "Pas foto latar belakang biru (2x3 = 4 lembar, 4x6 = 2 lembar)",
                ],
                estimasi: "1 - 2 Hari Kerja",
                biaya: "Gratis",
            },
            {
                nama: "Surat Keterangan Riwayat Tanah / Tidak Sengketa",
                deskripsi:
                    "Surat keterangan untuk memperkuat pembuktian riwayat kepemilikan tanah dan menyatakan tanah tersebut bebas dari sengketa hukum.",
                syarat: [
                    "Surat pengantar RT/RW setempat",
                    "Bukti kepemilikan awal (Girik, Pipil, Letter C, atau Akta Jual Beli)",
                    "Fotokopi KTP & KK pemohon",
                    "Surat pernyataan tidak sengketa yang ditandatangani oleh tetangga batas tanah dan diketahui RT/RW",
                ],
                estimasi: "3 - 5 Hari Kerja (memerlukan peninjauan lapangan)",
                biaya: "Gratis",
            },
        ],
    },
];

const layananCategories = env
    ? await getLayananData(env.DB)
    : fallbackLayananCategories;

const aspirasiStatus = Astro.url.searchParams.get("aspirasi");
---

<Layout
    title="Layanan Kelurahan | Kelurahan Palabuhanratu"
    description="Daftar layanan administrasi kependudukan, perizinan usaha, kesejahteraan sosial, dan pertanahan resmi di Kelurahan Palabuhanratu."
>
    <!-- Hero -->
    <section class="relative">
        <div class="h-48 sm:h-60 overflow-hidden">
            <img
                src="/images/tile_layanan.png"
                alt="Layanan Masyarakat Kelurahan Palabuhanratu"
                class="w-full h-full object-cover"
            />
        </div>
        <div class="absolute inset-0" style="background: rgba(10,54,80,0.65);">
        </div>
        <div class="absolute inset-0 flex items-end">
            <div
                class="mx-auto max-w-[1152px] px-4 sm:px-6 w-full pb-6 text-white"
            >
                <nav
                    aria-label="Breadcrumb"
                    class="text-sm text-white/80 flex items-center gap-1.5"
                >
                    <a href="/" class="hover:text-white">Beranda</a>
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    <span class="font-medium">Layanan Kelurahan</span>
                </nav>
                <h1
                    class="text-3xl sm:text-4xl font-heading font-extrabold mt-1"
                >
                    Layanan Publik & Administrasi
                </h1>
                <p class="text-white/85 mt-1 max-w-xl">
                    Informasi alur, syarat, dan estimasi waktu pelayanan bagi
                    warga Kelurahan Palabuhanratu.
                </p>
            </div>
        </div>
    </section>

    <main
        id="main"
        class="mx-auto max-w-[1152px] px-4 sm:px-6 py-10 space-y-10"
    >
        <!-- Panduan singkat -->
        <section
            class="bg-white border border-line rounded-2xl p-5 sm:p-6 shadow-sm"
        >
            <h2
                class="font-heading font-bold text-lg text-primary mb-3 flex items-center gap-2"
            >
                <i data-lucide="info" class="w-5 h-5 text-accent"></i>
                Panduan Umum Layanan
            </h2>
            <ul
                class="grid grid-cols-1 md:grid-cols-3 gap-3 text-sm text-text-muted"
            >
                <li class="flex gap-2">
                    <span class="font-bold text-accent">•</span><span
                        >Bawa berkas asli sebagai pembanding saat verifikasi.</span
                    >
                </li>
                <li class="flex gap-2">
                    <span class="font-bold text-accent">•</span><span
                        >Surat pengantar RT/RW wajib mencantumkan tanda tangan
                        aktif.</span
                    >
                </li>
                <li class="flex gap-2">
                    <span class="font-bold text-accent">•</span><span
                        >Seluruh pelayanan administrasi kelurahan adalah <strong
                            >100% GRATIS</strong
                        >.</span
                    >
                </li>
            </ul>
        </section>

        <!-- Slider Card Layanan -->
        <section>
            <div class="flex items-end justify-between mb-4 gap-3">
                <div>
                    <h2
                        class="font-heading font-extrabold text-2xl text-primary"
                    >
                        Daftar Layanan
                    </h2>
                    <p class="text-sm text-text-muted mt-1">
                        Geser untuk melihat layanan, syarat ringkas, estimasi,
                        dan biaya.
                    </p>
                </div>
                <a
                    href="/kontak"
                    class="inline-flex items-center gap-2 text-sm font-heading font-semibold text-accent hover:underline"
                >
                    Butuh Bantuan <i data-lucide="arrow-right" class="w-4 h-4"
                    ></i>
                </a>
            </div>

            <div
                id="layanan-page-slider"
                class="overflow-hidden"
                data-auto-slider
                data-interval="4300"
            >
                <div
                    class="flex gap-5 transition-transform duration-500 ease-out will-change-transform"
                    data-slider-track
                >
                    {
                        layananCategories.flatMap((cat) =>
                            cat.items.map((item) => (
                                <article class="bg-white border border-line rounded-2xl p-5 shadow-[0_4px_10px_rgba(15,36,51,.08)] shrink-0 basis-[90%] sm:basis-[48%] lg:basis-[31.6%] flex flex-col min-h-[22rem]">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="text-[11px] px-2.5 py-1 rounded-full bg-accent/10 text-accent font-heading font-semibold">
                                            {cat.title}
                                        </span>
                                    </div>

                                    <h3 class="font-heading font-bold text-base text-text mb-2 line-clamp-2">
                                        {item.nama}
                                    </h3>
                                    <p class="text-sm text-text-muted mb-4 line-clamp-3">
                                        {item.deskripsi}
                                    </p>

                                    <div class="bg-bg rounded-xl p-3 border border-line mb-4">
                                        <p class="text-[11px] font-heading font-semibold text-primary uppercase tracking-wider mb-2">
                                            Syarat Utama
                                        </p>
                                        <ul class="space-y-1.5 text-xs text-text-muted">
                                            {item.syarat
                                                .slice(0, 3)
                                                .map((sy) => (
                                                    <li class="flex items-start gap-1.5">
                                                        <i
                                                            data-lucide="check-circle"
                                                            class="w-3.5 h-3.5 text-emerald-600 mt-0.5 flex-shrink-0"
                                                        />
                                                        <span class="line-clamp-2">
                                                            {sy}
                                                        </span>
                                                    </li>
                                                ))}
                                        </ul>
                                    </div>

                                    <div class="mt-auto pt-3 border-t border-line flex items-center justify-between text-xs">
                                        <span class="inline-flex items-center gap-1.5 text-text-muted">
                                            <i
                                                data-lucide="clock"
                                                class="w-3.5 h-3.5 text-accent"
                                            />
                                            {item.estimasi}
                                        </span>
                                        <span class="inline-flex items-center gap-1.5 text-emerald-700 font-semibold">
                                            <i
                                                data-lucide="tag"
                                                class="w-3.5 h-3.5 text-accent"
                                            />
                                            {item.biaya}
                                        </span>
                                    </div>
                                </article>
                            )),
                        )
                    }
                </div>
            </div>
        </section>

        <!-- Aspirasi Masyarakat -->
        <section
            class="bg-white border border-line rounded-2xl p-6 sm:p-8 shadow-sm"
        >
            <div class="flex items-start justify-between gap-4 flex-wrap">
                <div>
                    <h2
                        class="font-heading font-extrabold text-2xl text-primary"
                    >
                        Aspirasi Masyarakat
                    </h2>
                    <p class="text-sm text-text-muted mt-1 max-w-2xl">
                        Sampaikan masukan, saran, atau laporan untuk peningkatan
                        layanan di Kelurahan Palabuhanratu.
                    </p>
                </div>
                <span
                    class="text-xs font-heading font-semibold px-3 py-1 rounded-full bg-sand text-primary"
                    >Akan ditinjau petugas</span
                >
            </div>

            {
                aspirasiStatus === "ok" && (
                    <div
                        class="mt-4 p-3 rounded-lg text-sm font-medium"
                        style="background:#D1FAE5; color:#065F46; border:1px solid #6EE7B7;"
                    >
                        Terima kasih, aspirasi Anda berhasil dikirim.
                    </div>
                )
            }
            {
                (aspirasiStatus === "invalid" ||
                    aspirasiStatus === "error") && (
                    <div
                        class="mt-4 p-3 rounded-lg text-sm font-medium"
                        style="background:#FEE2E2; color:#991B1B; border:1px solid #FCA5A5;"
                    >
                        Gagal mengirim aspirasi. Pastikan nama dan isi aspirasi
                        valid.
                    </div>
                )
            }
            {
                aspirasiStatus === "limit" && (
                    <div
                        class="mt-4 p-3 rounded-lg text-sm font-medium"
                        style="background:#FEF3C7; color:#92400E; border:1px solid #FCD34D;"
                    >
                        Anda terlalu sering mengirim aspirasi. Silakan coba lagi
                        beberapa menit lagi.
                    </div>
                )
            }

            <form
                class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4"
                action="/api/aspirasi"
                method="POST"
            >
                <label class="block">
                    <span class="text-sm font-heading font-medium text-text"
                        >Nama</span
                    >
                    <input
                        type="text"
                        name="nama"
                        required
                        minlength="2"
                        maxlength="100"
                        placeholder="Nama lengkap"
                        class="mt-1 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:outline-none focus:border-accent"
                    />
                </label>
                <label class="block">
                    <span class="text-sm font-heading font-medium text-text"
                        >Kontak (WA / Email)</span
                    >
                    <input
                        type="text"
                        name="kontak"
                        maxlength="120"
                        placeholder="08xx atau email"
                        class="mt-1 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:outline-none focus:border-accent"
                    />
                </label>
                <label class="block md:col-span-2">
                    <span class="text-sm font-heading font-medium text-text"
                        >Isi Aspirasi</span
                    >
                    <textarea
                        name="aspirasi"
                        rows="5"
                        required
                        minlength="10"
                        maxlength="2000"
                        placeholder="Tulis aspirasi Anda di sini..."
                        class="mt-1 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:outline-none focus:border-accent"
                    ></textarea>
                </label>
                <input
                    type="text"
                    name="website"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                    style="position:absolute; left:-9999px; opacity:0; pointer-events:none;"
                />

                <div class="md:col-span-2 flex flex-wrap gap-3 items-center">
                    <button
                        type="submit"
                        class="inline-flex items-center gap-2 bg-accent hover:bg-[#0a7d88] text-white font-heading font-semibold px-5 py-2.5 rounded-lg transition-colors min-h-[44px]"
                    >
                        <i data-lucide="send" class="w-4 h-4"></i>
                        Kirim Aspirasi
                    </button>
                    <a
                        href={s.kontak_wa
                            ? `https://wa.me/${String(s.kontak_wa).replace(/[^0-9]/g, "")}`
                            : "/kontak"}
                        target={s.kontak_wa ? "_blank" : undefined}
                        rel={s.kontak_wa ? "noopener noreferrer" : undefined}
                        class="inline-flex items-center gap-2 border border-line hover:border-accent text-text font-heading font-semibold px-4 py-2.5 rounded-lg transition-colors min-h-[44px]"
                    >
                        <i data-lucide="message-circle" class="w-4 h-4"></i>
                        {
                            s.kontak_wa
                                ? "Kirim via WhatsApp"
                                : "Lihat Kontak Kelurahan"
                        }
                    </a>
                </div>
            </form>
        </section>
    </main>
</Layout>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        const sliderEl = document.getElementById("layanan-page-slider");
        if (!sliderEl) return;

        const track = sliderEl.querySelector("[data-slider-track]");
        if (!track) return;

        let cards = Array.from(track.children);
        if (cards.length <= 1) return;

        let current = 0;
        let timer = null;

        function metrics() {
            const first = cards[0];
            if (!first)
                return { cardWidth: 0, gap: 0, visible: 1, maxIndex: 0 };
            const cardWidth = first.getBoundingClientRect().width;
            const styles = window.getComputedStyle(track);
            const gap = parseFloat(styles.columnGap || styles.gap || "0");
            const visible = Math.max(
                1,
                Math.round((sliderEl.clientWidth + gap) / (cardWidth + gap)),
            );
            const maxIndex = Math.max(0, cards.length - visible);
            return { cardWidth, gap, visible, maxIndex };
        }

        // duplikasi jika item sedikit agar tetap bisa auto-slide
        const originals = [...cards];
        let safety = 0;
        while (safety < 3) {
            const { visible } = metrics();
            if (cards.length > visible) break;
            originals.forEach((card) =>
                track.appendChild(card.cloneNode(true)),
            );
            cards = Array.from(track.children);
            safety++;
        }

        function goTo(index) {
            const { cardWidth, gap, maxIndex } = metrics();
            if (!cardWidth) return;
            current = index > maxIndex ? 0 : index < 0 ? maxIndex : index;
            track.style.transform = `translateX(-${current * (cardWidth + gap)}px)`;
        }

        function stop() {
            if (timer) {
                window.clearInterval(timer);
                timer = null;
            }
        }

        function start() {
            const interval = Number(
                sliderEl.getAttribute("data-interval") || 4300,
            );
            const { maxIndex } = metrics();
            if (maxIndex <= 0) return;
            stop();
            timer = window.setInterval(() => goTo(current + 1), interval);
        }

        sliderEl.addEventListener("mouseenter", stop);
        sliderEl.addEventListener("mouseleave", start);
        window.addEventListener("resize", () => {
            goTo(current);
            start();
        });

        goTo(0);
        start();

        if (typeof lucide !== "undefined") lucide.createIcons();
    });
</script>
